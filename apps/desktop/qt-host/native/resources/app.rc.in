IDI_APP_ICON ICON "@APP_ICON_PATH@"

// Block 16.QoL+ (2026-06-05) — version/description resource so Windows shows a
// friendly, trustworthy name for this process. Without it, Task Manager and the
// "Apps" view list the raw image name `nrr_qt_native_host.exe`, which looks
// foreign/suspicious to an end user sitting under the NetRuleRouter app group.
// FileDescription is what Task Manager renders in its "Name" column, so it reads
// as "NetRuleRouter" (the UI window host) — the same product, not a stranger.
//
// The resource MUST use the literal id `1` (not the `VS_VERSION_INFO` macro):
// without `#include <windows.h>` that macro is an undefined identifier, so rc
// stores the version block under the NAME "VS_VERSION_INFO" instead of id 1.
// Windows' GetFileVersionInfo (and .NET FileVersionInfo / Task Manager) only
// reads RT_VERSION id 1 → otherwise every field reads back empty even though
// the bytes are present.
1 VERSIONINFO
 FILEVERSION 0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "NetRuleRouter"
            VALUE "FileDescription", "NetRuleRouter (interface)"
            VALUE "InternalName", "NetRuleRouter (interface)"
            VALUE "OriginalFilename", "nrr_qt_native_host.exe"
            VALUE "ProductName", "NetRuleRouter"
            VALUE "FileVersion", "0.1.0.0"
            VALUE "ProductVersion", "0.1.0.0"
            VALUE "LegalCopyright", "MPL-2.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
