[Desktop Entry]
# The file basename must match QGuiApplication::setDesktopFileName in the Qt
# host: that value is the Wayland app_id a compositor looks this entry up by.
# NoDisplay: the tray is started by the main window, not picked from a menu.
# This file is the single body of the entry: install-desktop.sh and the
# autostart toggle both rewrite only its Exec= line, so its prompt windows and
# the session's startup list carry the same name and icon.
Type=Application
Version=1.0
Name=NetRuleRouter Tray
Name[ru]=NetRuleRouter — значок в трее
Comment=Status icon for NetRuleRouter
Comment[ru]=Значок состояния NetRuleRouter в системном лотке
Exec=netrulerouter-tray
Icon=netrulerouter
Terminal=false
Categories=Network;System;Utility;
NoDisplay=true
StartupNotify=false
StartupWMClass=NetRuleRouterTray
X-GNOME-Autostart-enabled=true
