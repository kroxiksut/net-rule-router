# pacman hooks for netrulerouter-bin. The service is not enabled on install, as
# Arch packages do not; an upgrade restarts it only if it was running, and a
# removal stops it and puts the network back first, as the .deb does.

_nrr_lib=/usr/libexec/netrulerouter/scripts/lib

_nrr_load() {
  . "$_nrr_lib/service-paths.sh"
  . "$_nrr_lib/package-functions.sh"
}

post_install() {
  echo "NetRuleRouter is installed. Start the service and keep it on at boot:"
  echo "    sudo systemctl enable --now netrulerouter.service"
  echo "If it ever leaves the machine without network:"
  echo "    sudo /usr/libexec/netrulerouter/scripts/reset-network.sh"
}

post_upgrade() {
  _nrr_load && nrr_pkg_restart_if_running
}

# post_remove runs after the helper scripts are gone, so pre_remove is the only
# step that can give DNS back. When the helpers cannot be loaded (damaged or
# half-removed install) this does the part that matters by hand: the system's
# resolv.conf, the NetworkManager drop-in, the dummy link, the packet table and
# our routing rules and tables. Idempotent, acts only on traces of ours. It does
# not hand `~.` back to systemd-resolved links, nor drop a resolvconf record:
# those need the helpers, and a reboot clears them.

# Mirrors of platform/linux policy_routing: PRIORITY_BAND, and SYSTEM_TABLE,
# from which every table up is ours.
_nrr_rule_priority_first=30100
_nrr_rule_priority_last=30119
_nrr_our_table_first=2147483647

# The per-user routing rules (a uid range in our band), then the tables they
# pointed at. Without its rule a table is inert, so rules go first.
_nrr_routing_undo() {
  command -v ip >/dev/null 2>&1 || return 0
  for _family in -4 -6; do
    # With IPv6 disabled `ip -6` fails outright, and nothing of ours is there.
    _rules=$(ip "$_family" rule show 2>/dev/null) || continue
    printf '%s\n' "$_rules" |
      awk -v first="$_nrr_rule_priority_first" -v last="$_nrr_rule_priority_last" '{
        prio = $1
        sub(/:$/, "", prio)
        if (prio !~ /^[0-9]+$/ || prio + 0 < first + 0 || prio + 0 > last + 0) next
        uids = ""
        lookup = ""
        for (i = 2; i < NF; i++) {
          if ($i == "uidrange" && uids == "") uids = $(i + 1)
          if ($i == "lookup" && lookup == "") lookup = $(i + 1)
        }
        if (uids != "" && lookup != "") print prio, uids, lookup
      }' |
      while read -r _prio _uids _lookup; do
        ip "$_family" rule del priority "$_prio" uidrange "$_uids" lookup "$_lookup" >/dev/null 2>&1
      done
    ip "$_family" route show table all 2>/dev/null |
      awk -v first="$_nrr_our_table_first" '{
        for (i = 1; i < NF; i++)
          if ($i == "table" && $(i + 1) ~ /^[0-9]+$/ && $(i + 1) + 0 >= first + 0 && $(i + 1) + 0 < 4294967295)
            print $(i + 1)
      }' |
      sort -u |
      while read -r _table; do
        ip "$_family" route flush table "$_table" >/dev/null 2>&1
      done
  done
  return 0
}

_nrr_minimal_dns_undo() {
  _unit=netrulerouter.service
  _state=/var/lib/netrulerouter
  _marker="# NetRuleRouter answers DNS here; the system's own file returns when it stops."
  systemctl disable --now "$_unit" >/dev/null 2>&1 || true
  if systemctl is-active --quiet "$_unit" 2>/dev/null; then
    systemctl kill -s KILL "$_unit" >/dev/null 2>&1 || true
  fi
  command -v nft >/dev/null 2>&1 && nft delete table inet nrr >/dev/null 2>&1
  command -v ip >/dev/null 2>&1 && ip link del netrulerouter >/dev/null 2>&1
  _nrr_routing_undo
  if rm -f -- /run/NetworkManager/conf.d/99-netrulerouter-dns.conf 2>/dev/null; then
    command -v nmcli >/dev/null 2>&1 && nmcli general reload >/dev/null 2>&1
  fi
  _first=
  [ -r /etc/resolv.conf ] && _first=$(head -n 1 /etc/resolv.conf | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
  if [ "$_first" = "$_marker" ] && [ -r "$_state/resolv.conf.system" ]; then
    if [ -r "$_state/resolv.conf.system-link" ]; then
      _target=$(head -n 1 "$_state/resolv.conf.system-link" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
      rm -f -- /etc/.resolv.conf.netrulerouter-link
      ln -s -- "$_target" /etc/.resolv.conf.netrulerouter-link &&
        mv -f -- /etc/.resolv.conf.netrulerouter-link /etc/resolv.conf
    else
      cat -- "$_state/resolv.conf.system" >/etc/.resolv.conf.netrulerouter-new &&
        chmod 0644 /etc/.resolv.conf.netrulerouter-new &&
        mv -f -- /etc/.resolv.conf.netrulerouter-new /etc/resolv.conf
    fi
  fi
  command -v resolvectl >/dev/null 2>&1 && resolvectl flush-caches >/dev/null 2>&1
  return 0
}

pre_remove() {
  if [ -r "$_nrr_lib/service-paths.sh" ] && [ -r "$_nrr_lib/package-functions.sh" ] && _nrr_load; then
    nrr_pkg_stop_and_reset_network
  else
    _nrr_minimal_dns_undo
    echo "netrulerouter: the helper scripts could not be loaded; DNS was given back by hand, a reboot clears what else is left." >&2
  fi
  return 0
}

post_remove() {
  systemctl daemon-reload >/dev/null 2>&1 || true
  systemctl reset-failed netrulerouter.service >/dev/null 2>&1 || true
  echo "The service data stays in /var/lib/netrulerouter; remove it by hand if"
  echo "you no longer need it. The audit trail is in the same place."
}
