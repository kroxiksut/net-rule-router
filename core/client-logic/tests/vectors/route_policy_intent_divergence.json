{
  "description": "pure.js routePolicyIntentDivergence",
  "cases": [
    {
      "name": "nothing recorded",
      "input": {
        "intent": {},
        "service": {
          "leak-protection": "everything"
        }
      },
      "expected": []
    },
    {
      "name": "a wiped service answers with its defaults",
      "input": {
        "intent": {
          "leak-protection": "everything"
        },
        "service": {}
      },
      "expected": [
        "leak-protection"
      ]
    },
    {
      "name": "the same value",
      "input": {
        "intent": {
          "leak-protection": "everything"
        },
        "service": {
          "leak-protection": "everything"
        }
      },
      "expected": []
    },
    {
      "name": "a number recorded as text is the same number",
      "input": {
        "intent": {
          "primary-probe-timeout-ms": "2000"
        },
        "service": {
          "primary-probe-timeout-ms": 2000
        }
      },
      "expected": []
    },
    {
      "name": "a number the service lost",
      "input": {
        "intent": {
          "primary-probe-timeout-ms": "2000"
        },
        "service": {}
      },
      "expected": [
        "primary-probe-timeout-ms"
      ]
    },
    {
      "name": "a switch turned off against the default on",
      "input": {
        "intent": {
          "include-subdomains": false
        },
        "service": {}
      },
      "expected": [
        "include-subdomains"
      ]
    },
    {
      "name": "a binding the service does not hold",
      "input": {
        "intent": {
          "secondary": {
            "stable-id": "B",
            "display-name": "Tunnel",
            "user-confirmed": true
          }
        },
        "service": {}
      },
      "expected": [
        "secondary"
      ]
    },
    {
      "name": "the same binding",
      "input": {
        "intent": {
          "secondary": {
            "stable-id": "B",
            "display-name": "Tunnel",
            "user-confirmed": true
          }
        },
        "service": {
          "secondary": {
            "stable-id": "B",
            "display-name": "Other name",
            "user-confirmed": false
          }
        }
      },
      "expected": []
    },
    {
      "name": "a binding the service re-matched to a new id",
      "input": {
        "intent": {
          "secondary": {
            "stable-id": "B",
            "display-name": "Tunnel",
            "user-confirmed": true
          }
        },
        "service": {
          "secondary": {
            "stable-id": "B2",
            "display-name": "Tunnel",
            "user-confirmed": true,
            "known-stable-ids": [
              "B"
            ]
          }
        }
      },
      "expected": []
    },
    {
      "name": "another adapter bound",
      "input": {
        "intent": {
          "primary": {
            "stable-id": "A",
            "display-name": "Ethernet",
            "user-confirmed": true
          }
        },
        "service": {
          "primary": {
            "stable-id": "C",
            "display-name": "Wi-Fi",
            "user-confirmed": true
          }
        }
      },
      "expected": [
        "primary"
      ]
    },
    {
      "name": "a key this build has no field for",
      "input": {
        "intent": {
          "future-field": true
        },
        "service": {}
      },
      "expected": []
    },
    {
      "name": "a binding with no id",
      "input": {
        "intent": {
          "primary": {
            "stable-id": "",
            "display-name": "x"
          }
        },
        "service": {}
      },
      "expected": []
    },
    {
      "name": "an empty mode is the default mode",
      "input": {
        "intent": {
          "mode": ""
        },
        "service": {}
      },
      "expected": []
    },
    {
      "name": "a damaged level reads as off",
      "input": {
        "intent": {
          "leak-protection": "block-all"
        },
        "service": {
          "leak-protection": "off"
        }
      },
      "expected": []
    },
    {
      "name": "routed sites under the additional route the service holds read as everything",
      "input": {
        "intent": {
          "leak-protection": "sites"
        },
        "service": {
          "mode": "prefer-secondary-when-available",
          "leak-protection": "everything"
        }
      },
      "expected": []
    },
    {
      "name": "a weaker level at the service diverges",
      "input": {
        "intent": {
          "leak-protection": "everything"
        },
        "service": {
          "leak-protection": "sites"
        }
      },
      "expected": [
        "leak-protection"
      ]
    },
    {
      "name": "a retired default route and retired protection keys read as what they meant",
      "input": {
        "intent": {
          "mode": "strict-secondary-fail-closed",
          "kill-switch-enabled": true,
          "kill-switch-fail-closed": true,
          "kill-switch-block-all": true,
          "mode-a-coverage-strategy": "fail-closed-unknown"
        },
        "service": {
          "mode": "prefer-secondary-when-available",
          "leak-protection": "everything"
        }
      },
      "expected": []
    },
    {
      "name": "several keys come back sorted",
      "input": {
        "intent": {
          "mode": "prefer-secondary-when-available",
          "doh-lockdown-enabled": true,
          "auto-rules-mode": "off"
        },
        "service": {}
      },
      "expected": [
        "auto-rules-mode",
        "doh-lockdown-enabled",
        "mode"
      ]
    },
    {
      "name": "the strict mode of an earlier build diverges from the main default route",
      "input": {
        "intent": {
          "mode": "strict-secondary-fail-closed"
        },
        "service": {
          "mode": "prefer-primary",
          "leak-protection": "off"
        }
      },
      "expected": [
        "leak-protection",
        "mode"
      ]
    }
  ]
}
