{
  "description": "rules.js vpnGatewayRuleDraft: the rule that lets a VPN reach its gateway over the chosen route",
  "cases": [
    { "name": "chosen ipv4 address", "input": { "input": "203.0.113.5", "program": "corpvpn.exe", "route": "secondary", "template": "VPN gateway: {program}" }, "expected": { "rule-type": "exact-ip", "value": "203.0.113.5", "route": "secondary", "comment": "VPN gateway: corpvpn.exe" } },
    { "name": "ipv6 lower-cased", "input": { "input": "2001:DB8::A", "program": "corpvpn.exe", "route": "secondary", "template": "VPN gateway: {program}" }, "expected": { "rule-type": "exact-ip", "value": "2001:db8::a", "route": "secondary", "comment": "VPN gateway: corpvpn.exe" } },
    { "name": "ipv4-mapped ipv6", "input": { "input": "::ffff:192.0.2.1", "program": "corpvpn.exe", "route": "primary", "template": "VPN gateway: {program}" }, "expected": { "rule-type": "exact-ip", "value": "::ffff:192.0.2.1", "route": "primary", "comment": "VPN gateway: corpvpn.exe" } },
    { "name": "bracketed ipv6", "input": { "input": "[2001:db8::7]", "program": "corpvpn.exe", "route": "secondary", "template": "VPN gateway: {program}" }, "expected": { "rule-type": "exact-ip", "value": "2001:db8::7", "route": "secondary", "comment": "VPN gateway: corpvpn.exe" } },
    { "name": "bracketed ipv6 with port", "input": { "input": "[2001:db8::7]:500", "program": "corpvpn.exe", "route": "secondary", "template": "VPN gateway: {program}" }, "expected": { "rule-type": "exact-ip", "value": "2001:db8::7", "route": "secondary", "comment": "VPN gateway: corpvpn.exe" } },
    { "name": "ipv4 with port", "input": { "input": " 203.0.113.5:4500 ", "program": "corpvpn.exe", "route": "secondary", "template": "VPN gateway: {program}" }, "expected": { "rule-type": "exact-ip", "value": "203.0.113.5", "route": "secondary", "comment": "VPN gateway: corpvpn.exe" } },
    { "name": "chosen hostname is one host", "input": { "input": "GW.Corp.Example", "program": "corpvpn.exe", "route": "secondary", "template": "VPN gateway: {program}" }, "expected": { "rule-type": "domain", "value": "gw.corp.example", "route": "secondary", "comment": "VPN gateway: corpvpn.exe" } },
    { "name": "url cut to its host, www kept", "input": { "input": "https://www.vpn.corp.example:443/remote/login", "program": "corpvpn.exe", "route": "secondary", "template": "VPN gateway: {program}" }, "expected": { "rule-type": "domain", "value": "www.vpn.corp.example", "route": "secondary", "comment": "VPN gateway: corpvpn.exe" } },
    { "name": "url naming an address", "input": { "input": "https://198.51.100.9/", "program": "corpvpn.exe", "route": "secondary", "template": "VPN gateway: {program}" }, "expected": { "rule-type": "exact-ip", "value": "198.51.100.9", "route": "secondary", "comment": "VPN gateway: corpvpn.exe" } },
    { "name": "trailing root dot dropped", "input": { "input": "gw.example.", "program": "corpvpn.exe", "route": "secondary", "template": "VPN gateway: {program}" }, "expected": { "rule-type": "domain", "value": "gw.example", "route": "secondary", "comment": "VPN gateway: corpvpn.exe" } },
    { "name": "unicode host", "input": { "input": "Шлюз.Пример", "program": "corpvpn.exe", "route": "secondary", "template": "Шлюз VPN: {program}" }, "expected": { "rule-type": "domain", "value": "шлюз.пример", "route": "secondary", "comment": "Шлюз VPN: corpvpn.exe" } },
    { "name": "program path reduced to its file name", "input": { "input": "203.0.113.5", "program": "C:\\Program Files\\Corp\\corpvpn.exe", "route": "secondary", "template": "VPN gateway: {program}" }, "expected": { "rule-type": "exact-ip", "value": "203.0.113.5", "route": "secondary", "comment": "VPN gateway: corpvpn.exe" } },
    { "name": "unix program path", "input": { "input": "203.0.113.5", "program": "/usr/sbin/corpvpnd", "route": "primary", "template": "{program} / {program}" }, "expected": { "rule-type": "exact-ip", "value": "203.0.113.5", "route": "primary", "comment": "corpvpnd / corpvpnd" } },
    { "name": "template without placeholder", "input": { "input": "203.0.113.5", "program": "corpvpn.exe", "route": "secondary", "template": "gateway" }, "expected": { "rule-type": "exact-ip", "value": "203.0.113.5", "route": "secondary", "comment": "gateway" } },
    { "name": "no program", "input": { "input": "203.0.113.5", "program": "  ", "route": "secondary", "template": "VPN gateway: {program}" }, "expected": null },
    { "name": "path naming no file", "input": { "input": "203.0.113.5", "program": "C:\\Apps\\", "route": "secondary", "template": "VPN gateway: {program}" }, "expected": null },
    { "name": "empty input", "input": { "input": "   ", "program": "corpvpn.exe", "route": "secondary", "template": "VPN gateway: {program}" }, "expected": null },
    { "name": "single label", "input": { "input": "gateway", "program": "corpvpn.exe", "route": "secondary", "template": "VPN gateway: {program}" }, "expected": null },
    { "name": "spaces inside", "input": { "input": "my gateway.example", "program": "corpvpn.exe", "route": "secondary", "template": "VPN gateway: {program}" }, "expected": null },
    { "name": "mistyped address is not a host", "input": { "input": "256.1.1.1", "program": "corpvpn.exe", "route": "secondary", "template": "VPN gateway: {program}" }, "expected": null },
    { "name": "ipv6 group too long", "input": { "input": "12345::1", "program": "corpvpn.exe", "route": "secondary", "template": "VPN gateway: {program}" }, "expected": null },
    { "name": "label edged with a hyphen", "input": { "input": "-gw.example", "program": "corpvpn.exe", "route": "secondary", "template": "VPN gateway: {program}" }, "expected": null },
    { "name": "block is not a route", "input": { "input": "203.0.113.5", "program": "corpvpn.exe", "route": "block", "template": "VPN gateway: {program}" }, "expected": null }
  ]
}
