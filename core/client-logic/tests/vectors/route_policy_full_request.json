{
  "description": "pure.js buildFullRoutePolicyReq: the full-replacement request from a snapshot",
  "cases": [
    { "name": "empty snapshot with mode fallback", "input": { "snapshot": {}, "modeFallback": "prefer-secondary" } },
    { "name": "empty snapshot without fallback", "input": { "snapshot": {} } },
    { "name": "null snapshot", "input": { "snapshot": null, "modeFallback": "" } },
    { "name": "snapshot mode wins over fallback", "input": { "snapshot": { "mode": "prefer-primary" }, "modeFallback": "prefer-secondary" } },
    { "name": "empty mode takes the fallback", "input": { "snapshot": { "mode": "" }, "modeFallback": "prefer-secondary" } },
    { "name": "false mode takes the fallback", "input": { "snapshot": { "mode": false }, "modeFallback": "prefer-secondary" } },
    { "name": "unknown field rides back", "input": { "snapshot": { "future-field": { "nested": [1, 2] }, "kill-switch-enabled": true }, "modeFallback": "prefer-primary" } },
    { "name": "snapshot-only key dropped", "input": { "snapshot": { "secondary-link-provider-apps": ["client.exe"], "mode": "prefer-primary" } } },
    { "name": "nulls dropped and defaulted", "input": { "snapshot": { "include-subdomains": null, "future-null": null } } },
    { "name": "binding-source restamped", "input": { "snapshot": { "binding-source": "recovery" } } },
    { "name": "bindings pass through", "input": { "snapshot": {
        "primary": { "stable-id": "id-1", "display-name": "Ethernet", "user-confirmed": true },
        "secondary": { "stable-id": "id-2", "display-name": "Tunnel", "user-confirmed": false, "known-stable-ids": ["id-0"] }
      }, "modeFallback": "prefer-primary" } },
    { "name": "loose values normalised", "input": { "snapshot": {
        "kill-switch-protocols": 200, "allow-dns-over-primary": "false", "primary-probe-timeout-ms": "900",
        "short-name-suffix": 7, "kill-switch-fail-closed": 0
      } } },
    { "name": "full snapshot", "input": { "snapshot": {
        "mode": "prefer-secondary", "block-secondary-when-unavailable": true, "kill-switch-fail-closed": false,
        "kill-switch-protocols": 5, "kill-switch-block-all": true, "kill-switch-enabled": true,
        "allow-dns-over-primary": false, "include-subdomains": false, "shared-ip-policy": "any-ip",
        "mode-a-coverage-strategy": "per-host", "resolve-hosts-bypass": false, "doh-lockdown-enabled": true,
        "doh-lockdown-scope": "always", "browser-history-auto-seed": true, "kill-switch-strict-shared-ips": true,
        "auto-rules-mode": "off", "auto-rules-eager-delivery-names": true, "primary-probe-auto": true,
        "primary-probe-timeout-ms": 2000, "primary-probe-max-targets": 4, "primary-probe-repeat-secs": 60,
        "local-networks-auto-accept": true, "zone-priority-over-ip": true, "short-name-completion": true,
        "short-name-suffix": "corp.example", "binding-source": "user-assigned"
      }, "modeFallback": "prefer-primary" } }
  ]
}
