{
  "description": "pure.js routePolicyProtectionToRestore: protection the record holds stronger than the service, brought back without asking",
  "cases": [
    {
      "name": "nothing recorded",
      "input": {
        "intent": {},
        "service": {}
      },
      "expected": []
    },
    {
      "name": "on in the record, off at the service",
      "input": {
        "intent": {
          "leak-protection": "sites"
        },
        "service": {
          "leak-protection": "off"
        }
      },
      "expected": [
        "leak-protection"
      ]
    },
    {
      "name": "off by the service's fallback counts as off",
      "input": {
        "intent": {
          "doh-lockdown-enabled": true
        },
        "service": {}
      },
      "expected": [
        "doh-lockdown-enabled"
      ]
    },
    {
      "name": "already as strong",
      "input": {
        "intent": {
          "leak-protection": "everything"
        },
        "service": {
          "leak-protection": "everything"
        }
      },
      "expected": []
    },
    {
      "name": "a stronger level at the service stays",
      "input": {
        "intent": {
          "leak-protection": "sites"
        },
        "service": {
          "leak-protection": "everything"
        }
      },
      "expected": []
    },
    {
      "name": "never weakened this way",
      "input": {
        "intent": {
          "leak-protection": "off"
        },
        "service": {
          "leak-protection": "sites"
        }
      },
      "expected": []
    },
    {
      "name": "everything over routed sites",
      "input": {
        "intent": {
          "leak-protection": "everything"
        },
        "service": {
          "mode": "prefer-primary",
          "leak-protection": "sites",
          "secondary": { "stable-id": "B", "display-name": "Tunnel" }
        }
      },
      "expected": [
        "leak-protection"
      ]
    },
    {
      "name": "routed sites under the additional route come back as everything",
      "input": {
        "intent": {
          "leak-protection": "sites"
        },
        "service": {
          "mode": "prefer-secondary-when-available",
          "leak-protection": "off",
          "secondary": { "stable-id": "B", "display-name": "Tunnel" }
        }
      },
      "expected": [
        "leak-protection"
      ]
    },
    {
      "name": "a damaged value is not on",
      "input": {
        "intent": {
          "leak-protection": "block-all",
          "kill-switch-strict-shared-ips": 1
        },
        "service": {}
      },
      "expected": []
    },
    {
      "name": "a retired guard is restored as its level",
      "input": {
        "intent": {
          "kill-switch-enabled": true,
          "kill-switch-block-all": true
        },
        "service": { "secondary": { "stable-id": "B", "display-name": "Tunnel" } }
      },
      "expected": [
        "leak-protection"
      ]
    },
    {
      "name": "a non-protective key is not restored here",
      "input": {
        "intent": {
          "resolve-hosts-bypass": false,
          "kill-switch-strict-shared-ips": true
        },
        "service": { "kill-switch-strict-shared-ips": false }
      },
      "expected": [
        "kill-switch-strict-shared-ips"
      ]
    },
    {
      "name": "several, sorted",
      "input": {
        "intent": {
          "leak-protection": "everything",
          "kill-switch-strict-shared-ips": true,
          "doh-lockdown-enabled": true
        },
        "service": { "kill-switch-strict-shared-ips": false,
          "doh-lockdown-enabled": false,
          "secondary": { "stable-id": "B", "display-name": "Tunnel" }
        }
      },
      "expected": [
        "doh-lockdown-enabled",
        "kill-switch-strict-shared-ips",
        "leak-protection"
      ]
    },
    {
      "name": "everything is not raised unasked while the service has no additional adapter bound: it would close the internet",
      "input": {
        "intent": {
          "leak-protection": "everything",
          "secondary": { "stable-id": "B", "display-name": "Tunnel", "user-confirmed": true }
        },
        "service": {}
      },
      "expected": []
    },
    {
      "name": "routed sites under the additional route are not raised to everything with no additional adapter bound",
      "input": {
        "intent": {
          "leak-protection": "sites",
          "doh-lockdown-enabled": true
        },
        "service": {
          "mode": "prefer-secondary-when-available",
          "leak-protection": "off",
          "secondary": null
        }
      },
      "expected": [
        "doh-lockdown-enabled"
      ]
    },
    {
      "name": "the strict mode of an earlier build restores everything",
      "input": {
        "intent": {
          "mode": "strict-secondary-fail-closed"
        },
        "service": {
          "leak-protection": "sites",
          "secondary": { "stable-id": "B", "display-name": "Tunnel" }
        }
      },
      "expected": [
        "leak-protection"
      ]
    }
  ]
}
