{
  "description": "pure.js routePolicyCoerce: one value normalised to its wire shape",
  "cases": [
    { "name": "text absent", "input": { "key": "mode" }, "expected": "prefer-primary" },
    { "name": "text empty", "input": { "key": "mode", "raw": "" }, "expected": "prefer-primary" },
    { "name": "text null", "input": { "key": "mode", "raw": null }, "expected": "prefer-primary" },
    { "name": "text kept", "input": { "key": "mode", "raw": "prefer-secondary" }, "expected": "prefer-secondary" },
    { "name": "number as text", "input": { "key": "mode", "raw": 5 }, "expected": "5" },
    { "name": "boolean as text", "input": { "key": "shared-ip-policy", "raw": true }, "expected": "true" },
    { "name": "bool true", "input": { "key": "kill-switch-enabled", "raw": true }, "expected": true },
    { "name": "bool from string is false", "input": { "key": "kill-switch-enabled", "raw": "true" }, "expected": false },
    { "name": "bool from 1 is false", "input": { "key": "kill-switch-enabled", "raw": 1 }, "expected": false },
    { "name": "bool absent takes a true default", "input": { "key": "kill-switch-fail-closed" }, "expected": true },
    { "name": "bool false kept", "input": { "key": "kill-switch-fail-closed", "raw": false }, "expected": false },
    { "name": "protocols kept", "input": { "key": "kill-switch-protocols", "raw": 3 }, "expected": 3 },
    { "name": "protocols blocking nothing", "input": { "key": "kill-switch-protocols", "raw": 64 }, "expected": 127 },
    { "name": "protocols outside the mask", "input": { "key": "kill-switch-protocols", "raw": 128 }, "expected": 127 },
    { "name": "protocols negative", "input": { "key": "kill-switch-protocols", "raw": -1 }, "expected": 127 },
    { "name": "protocols with other bit", "input": { "key": "kill-switch-protocols", "raw": 65 }, "expected": 65 },
    { "name": "protocols from text", "input": { "key": "kill-switch-protocols", "raw": "5" }, "expected": 5 },
    { "name": "protocols fraction", "input": { "key": "kill-switch-protocols", "raw": 7.9 }, "expected": 7 },
    { "name": "number from text", "input": { "key": "primary-probe-timeout-ms", "raw": "2500" }, "expected": 2500 },
    { "name": "number from junk is zero", "input": { "key": "primary-probe-timeout-ms", "raw": "abc" }, "expected": 0 },
    { "name": "number wraps at 32 bits", "input": { "key": "primary-probe-timeout-ms", "raw": 4294967297 }, "expected": 1 },
    { "name": "number from bool", "input": { "key": "primary-probe-max-targets", "raw": true }, "expected": 1 },
    { "name": "number from hex text", "input": { "key": "primary-probe-repeat-secs", "raw": "0x10" }, "expected": 16 },
    { "name": "number from padded text", "input": { "key": "primary-probe-repeat-secs", "raw": " 12 " }, "expected": 12 },
    { "name": "number absent", "input": { "key": "primary-probe-max-targets" }, "expected": 8 },
    { "name": "empty text default", "input": { "key": "short-name-suffix", "raw": "" }, "expected": "" },
    { "name": "text suffix kept", "input": { "key": "short-name-suffix", "raw": "corp.example" }, "expected": "corp.example" },
    { "name": "unknown key passes text", "input": { "key": "future-field", "raw": "x" }, "expected": "x" },
    { "name": "unknown key passes number", "input": { "key": "future-field", "raw": 42 }, "expected": 42 },
    { "name": "snapshot-only key passes through", "input": { "key": "secondary-link-provider-apps", "raw": ["a.exe"] }, "expected": ["a.exe"] }
  ]
}
