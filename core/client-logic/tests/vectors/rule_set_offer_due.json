{
  "cases": [
    { "name": "an empty start, next launch: the service holds nothing, nothing is bound", "input": { "state": { "firstRunDone": true, "service": "running", "serviceRules": 0, "localRules": 0, "userBound": false, "setName": "Russia: local and foreign", "answered": false, "editsLocked": false } }, "expected": true },
    { "name": "the service is not running and nothing is bound", "input": { "state": { "firstRunDone": true, "service": "stopped", "serviceRules": -1, "localRules": 0, "userBound": false, "setName": "Russia: local and foreign", "answered": false, "editsLocked": false } }, "expected": true },
    { "name": "a set the user bound is theirs to load", "input": { "state": { "firstRunDone": true, "service": "running", "serviceRules": 0, "localRules": 0, "userBound": true, "setName": "Russia: local and foreign", "answered": false, "editsLocked": false } }, "expected": false },
    { "name": "answered once, in either client, is answered", "input": { "state": { "firstRunDone": true, "service": "running", "serviceRules": 0, "localRules": 0, "userBound": false, "setName": "Russia: local and foreign", "answered": true, "editsLocked": false } }, "expected": false },
    { "name": "the service holds rules", "input": { "state": { "firstRunDone": true, "service": "running", "serviceRules": 12, "localRules": 0, "userBound": false, "setName": "Russia: local and foreign", "answered": false, "editsLocked": false } }, "expected": false },
    { "name": "rules on screen not applied yet", "input": { "state": { "firstRunDone": true, "service": "running", "serviceRules": 0, "localRules": 3, "userBound": false, "setName": "Russia: local and foreign", "answered": false, "editsLocked": false } }, "expected": false },
    { "name": "rules added while the service is stopped", "input": { "state": { "firstRunDone": true, "service": "stopped", "serviceRules": -1, "localRules": 1, "userBound": false, "setName": "Russia: local and foreign", "answered": false, "editsLocked": false } }, "expected": false },
    { "name": "no set to offer", "input": { "state": { "firstRunDone": true, "service": "running", "serviceRules": 0, "localRules": 0, "userBound": false, "setName": "", "answered": false, "editsLocked": false } }, "expected": false },
    { "name": "a blank name is no set", "input": { "state": { "firstRunDone": true, "service": "stopped", "serviceRules": -1, "localRules": 0, "userBound": false, "setName": "  ", "answered": false, "editsLocked": false } }, "expected": false },
    { "name": "the first run is still open", "input": { "state": { "firstRunDone": false, "service": "running", "serviceRules": 0, "localRules": 0, "userBound": false, "setName": "Russia: local and foreign", "answered": false, "editsLocked": false } }, "expected": false },
    { "name": "the service has not answered yet", "input": { "state": { "firstRunDone": true, "service": "running", "serviceRules": -1, "localRules": 0, "userBound": false, "setName": "Russia: local and foreign", "answered": false, "editsLocked": false } }, "expected": false },
    { "name": "a service still connecting may hold rules", "input": { "state": { "firstRunDone": true, "service": "unknown", "serviceRules": -1, "localRules": 0, "userBound": false, "setName": "Russia: local and foreign", "answered": false, "editsLocked": false } }, "expected": false },
    { "name": "an administrator turned rule editing off: nothing could be loaded", "input": { "state": { "firstRunDone": true, "service": "running", "serviceRules": 0, "localRules": 0, "userBound": false, "setName": "Russia: local and foreign", "answered": false, "editsLocked": true } }, "expected": false },
    { "name": "a stopped service that answered rules before still has them", "input": { "state": { "firstRunDone": true, "service": "stopped", "serviceRules": 4, "localRules": 0, "userBound": false, "setName": "Russia: local and foreign", "answered": false, "editsLocked": false } }, "expected": false }
  ]
}
