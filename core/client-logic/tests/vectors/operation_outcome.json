{
  "description": "A completed operation must preserve partial or unconfirmed application; absent outcome remains compatible with older and non-activation replies.",
  "cases": [
    { "name": "completed", "input": { "ok": true, "status": { "state": "completed" } }, "expected": "" },
    { "name": "activation completed fully", "input": { "ok": true, "status": { "state": "completed", "result": { "outcome": "activated" } } }, "expected": "" },
    { "name": "same stored revision does not erase a prior partial failure", "input": { "ok": true, "status": { "state": "completed", "result": { "outcome": "already-active" } } }, "expected": "application-unconfirmed" },
    { "name": "baseline reset without apply receipt does not prove enforcement", "input": { "ok": true, "status": { "state": "completed", "result": { "outcome": "reset-to-baseline" } } }, "expected": "application-unconfirmed" },
    { "name": "safe disable remains compatible", "input": { "ok": true, "status": { "state": "completed", "result": { "outcome": "safe-disabled" } } }, "expected": "" },
    { "name": "already safely disabled remains compatible", "input": { "ok": true, "status": { "state": "completed", "result": { "outcome": "already-safe-disabled" } } }, "expected": "" },
    { "name": "audit restart remains compatible", "input": { "ok": true, "status": { "state": "completed", "result": { "outcome": "audit-chain-restarted" } } }, "expected": "" },
    { "name": "alert acknowledgement remains compatible", "input": { "ok": true, "status": { "state": "completed", "result": { "outcome": "alert-acknowledged" } } }, "expected": "" },
    { "name": "alert resolution remains compatible", "input": { "ok": true, "status": { "state": "completed", "result": { "outcome": "alert-resolved" } } }, "expected": "" },
    { "name": "unchanged alert remains compatible", "input": { "ok": true, "status": { "state": "completed", "result": { "outcome": "alert-unchanged" } } }, "expected": "" },
    { "name": "partial application is not full success", "input": { "ok": true, "status": { "state": "completed", "result": { "outcome": "applied-with-drift", "succeeded-sids": ["user-a"], "failed-sids": [["user-b", "synthetic failure"]] } } }, "expected": "applied-with-drift" },
    { "name": "partial application without details stays partial", "input": { "ok": true, "status": { "state": "completed", "result": { "outcome": "applied-with-drift" } } }, "expected": "applied-with-drift" },
    { "name": "new activation outcome is not assumed successful", "input": { "ok": true, "status": { "state": "completed", "result": { "outcome": "future-outcome" } } }, "expected": "application-unconfirmed" },
    { "name": "malformed outcome is not assumed successful", "input": { "ok": true, "status": { "state": "completed", "result": { "outcome": 7 } } }, "expected": "application-unconfirmed" },
    { "name": "failed with a code", "input": { "ok": true, "status": { "state": "failed", "error": { "code": "rule-cap-exceeded", "message": "m" } } }, "expected": "rule-cap-exceeded" },
    { "name": "failed with an empty code", "input": { "ok": true, "status": { "state": "failed", "error": { "code": "", "message": "m" } } }, "expected": "unknown" },
    { "name": "failed without an error", "input": { "ok": true, "status": { "state": "failed" } }, "expected": "unknown" },
    { "name": "running", "input": { "ok": true, "status": { "state": "running" } }, "expected": null },
    { "name": "queued", "input": { "ok": true, "status": { "state": "queued" } }, "expected": null },
    { "name": "call failed", "input": { "ok": false, "status": { "state": "completed" } }, "expected": null },
    { "name": "no status", "input": { "ok": true, "status": null }, "expected": null },
    { "name": "unknown state", "input": { "ok": true, "status": { "state": "later" } }, "expected": null }
  ]
}
