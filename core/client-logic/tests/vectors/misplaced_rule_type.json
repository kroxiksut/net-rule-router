{
  "description": "rules.js misplacedRuleType / nrr_client_logic::rule_value_class::misplaced_rule_type: the rule type a value written as another type belongs to, \"\" when its type can hold it",
  "cases": [
    { "name": "exe under domains", "input": { "type": "domain", "value": "chrome.exe", "os": "windows" }, "expected": "application" },
    { "name": "exe under zones", "input": { "type": "zone", "value": "chrome.exe", "os": "windows" }, "expected": "application" },
    { "name": "exe under domains on linux", "input": { "type": "domain", "value": "chrome.exe", "os": "linux" }, "expected": "application" },
    { "name": "address as a program", "input": { "type": "application", "value": "192.0.2.7", "os": "windows" }, "expected": "exact-ip" },
    { "name": "host as a windows program", "input": { "type": "application", "value": "example.com", "os": "windows" }, "expected": "domain" },
    { "name": "subnet as a program", "input": { "type": "application", "value": "10.0.0.0/24", "os": "windows" }, "expected": "subnet" },
    { "name": "subnet as a linux program", "input": { "type": "application", "value": "10.0.0.0/24", "os": "linux" }, "expected": "subnet" },
    { "name": "range as a program", "input": { "type": "application", "value": "192.0.2.10-192.0.2.40", "os": "macos" }, "expected": "ip-range" },
    { "name": "dotted linux program", "input": { "type": "application", "value": "example.com", "os": "linux" }, "expected": "" },
    { "name": "macos bundle id", "input": { "type": "application", "value": "org.example.app", "os": "macos" }, "expected": "" },
    { "name": "macos bundle glob", "input": { "type": "application", "value": "com.example.*", "os": "macos" }, "expected": "" },
    { "name": "subdomains as a linux program", "input": { "type": "application", "value": "*.example.com", "os": "linux" }, "expected": "domain" },
    { "name": "zone as a windows program", "input": { "type": "application", "value": "*.ru", "os": "windows" }, "expected": "zone" },
    { "name": "script glob on linux", "input": { "type": "application", "value": "*.sh", "os": "linux" }, "expected": "" },
    { "name": "one word as a program", "input": { "type": "application", "value": "telegram", "os": "windows" }, "expected": "" },
    { "name": "script as a windows program", "input": { "type": "application", "value": "script.ps1", "os": "windows" }, "expected": "" },
    { "name": "unknown os reads as windows", "input": { "type": "application", "value": "example.com", "os": "" }, "expected": "domain" },
    { "name": "host under ip", "input": { "type": "exact-ip", "value": "example.com", "os": "windows" }, "expected": "domain" },
    { "name": "host under cidr", "input": { "type": "subnet", "value": "example.com", "os": "windows" }, "expected": "domain" },
    { "name": "host under ranges", "input": { "type": "ip-range", "value": "example.com", "os": "windows" }, "expected": "domain" },
    { "name": "subnet under ip", "input": { "type": "exact-ip", "value": "10.0.0.0/8", "os": "windows" }, "expected": "subnet" },
    { "name": "range under ip", "input": { "type": "exact-ip", "value": "10.0.0.1-10.0.0.9", "os": "windows" }, "expected": "ip-range" },
    { "name": "address under cidr", "input": { "type": "subnet", "value": "10.0.0.1", "os": "windows" }, "expected": "exact-ip" },
    { "name": "subnet under ranges", "input": { "type": "ip-range", "value": "10.0.0.0/24", "os": "windows" }, "expected": "subnet" },
    { "name": "bad prefix stays in cidr", "input": { "type": "subnet", "value": "10.0.0.0/33", "os": "windows" }, "expected": "" },
    { "name": "bad prefix under ip", "input": { "type": "exact-ip", "value": "10.0.0.0/33", "os": "windows" }, "expected": "subnet" },
    { "name": "address under domains", "input": { "type": "domain", "value": "192.0.2.7", "os": "windows" }, "expected": "exact-ip" },
    { "name": "address under zones", "input": { "type": "zone", "value": "192.0.2.7", "os": "windows" }, "expected": "exact-ip" },
    { "name": "every zone under zones", "input": { "type": "zone", "value": "example.*", "os": "windows" }, "expected": "domain" },
    { "name": "compound zone", "input": { "type": "zone", "value": "corp.internal", "os": "windows" }, "expected": "" },
    { "name": "subdomains under zones", "input": { "type": "zone", "value": "*.example.com", "os": "windows" }, "expected": "" },
    { "name": "zone under domains", "input": { "type": "domain", "value": "*.ru", "os": "windows" }, "expected": "" },
    { "name": "one word under domains", "input": { "type": "domain", "value": "telegram", "os": "windows" }, "expected": "" },
    { "name": "one word under ip", "input": { "type": "exact-ip", "value": "telegram", "os": "windows" }, "expected": "" },
    { "name": "zone under ip", "input": { "type": "exact-ip", "value": "*.ru", "os": "windows" }, "expected": "zone" },
    { "name": "program glob under domains", "input": { "type": "domain", "value": "nord*", "os": "windows" }, "expected": "application" },
    { "name": "unknown type", "input": { "type": "suffix-domain", "value": "chrome.exe", "os": "windows" }, "expected": "" },
    { "name": "empty value", "input": { "type": "application", "value": "", "os": "windows" }, "expected": "" }
  ]
}
