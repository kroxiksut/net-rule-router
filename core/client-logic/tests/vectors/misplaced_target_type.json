    { "name": "domain", "input": { "key": "rules.validation.match-value-invalid.is-domain" }, "expected": "domain" },
    { "name": "exact ip", "input": { "key": "rules.validation.match-value-invalid.is-exact-ip" }, "expected": "exact-ip" },
    { "name": "subnet", "input": { "key": "rules.validation.match-value-invalid.is-subnet" }, "expected": "subnet" },
    { "name": "range", "input": { "key": "rules.validation.match-value-invalid.is-ip-range" }, "expected": "ip-range" },
    { "name": "application", "input": { "key": "rules.validation.match-value-invalid.is-application" }, "expected": "application" },
    { "name": "another refusal", "input": { "key": "rules.validation.match-value-invalid.domain" }, "expected": "" },
    { "name": "prefix alone", "input": { "key": "rules.validation.match-value-invalid.is-" }, "expected": "" },
    { "name": "no such type", "input": { "key": "rules.validation.match-value-invalid.is-port" }, "expected": "" },
    { "name": "prefix not at the start", "input": { "key": "x.rules.validation.match-value-invalid.is-zone" }, "expected": "" },
    { "name": "empty", "input": { "key": "" }, "expected": "" }
  ]
