{
  "description": "pure.js rulesBookUnreadable: whether a health answer says a stored rule book could not be read and the last applied rules are held",
  "cases": [
    {
      "name": "no answer",
      "input": {
        "health": null
      },
      "expected": false
    },
    {
      "name": "healthy, no components",
      "input": {
        "health": {
          "service-state": "running",
          "components": []
        }
      },
      "expected": false
    },
    {
      "name": "missing components",
      "input": {
        "health": {
          "service-state": "running"
        }
      },
      "expected": false
    },
    {
      "name": "the policy component says so",
      "input": {
        "health": {
          "components": [
            {
              "component": "policy",
              "severity": "degraded",
              "message": "a stored rule book could not be read; the last applied rules stay in force (1 account(s))"
            }
          ]
        }
      },
      "expected": true
    },
    {
      "name": "the same words on another component",
      "input": {
        "health": {
          "components": [
            {
              "component": "apply",
              "severity": "degraded",
              "message": "a stored rule book could not be read; the last applied rules stay in force (1 account(s))"
            }
          ]
        }
      },
      "expected": false
    },
    {
      "name": "the words not at the start",
      "input": {
        "health": {
          "components": [
            {
              "component": "policy",
              "severity": "degraded",
              "message": "note: a stored rule book could not be read"
            }
          ]
        }
      },
      "expected": false
    },
    {
      "name": "another policy message",
      "input": {
        "health": {
          "components": [
            {
              "component": "policy",
              "severity": "warning",
              "message": "integrity check pending"
            }
          ]
        }
      },
      "expected": false
    },
    {
      "name": "a policy component without a message",
      "input": {
        "health": {
          "components": [
            {
              "component": "policy",
              "severity": "degraded"
            }
          ]
        }
      },
      "expected": false
    },
    {
      "name": "components is not a list",
      "input": {
        "health": {
          "components": {
            "component": "policy",
            "message": "a stored rule book could not be read"
          }
        }
      },
      "expected": false
    },
    {
      "name": "said among other components",
      "input": {
        "health": {
          "components": [
            null,
            {
              "component": "storage",
              "severity": "ok",
              "message": "ok"
            },
            {
              "component": "policy",
              "severity": "degraded",
              "message": "a stored rule book could not be read; the last applied rules stay in force (2 account(s))"
            }
          ]
        }
      },
      "expected": true
    }
  ]
}
