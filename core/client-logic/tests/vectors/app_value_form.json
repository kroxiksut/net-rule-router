{
  "description": "rules.js appValueForm / nrr_client_logic::rule_value_class::app_value_form: what an application rule value names on an OS — a name, a name glob, a path form, or the path error the service's verdict names",
  "cases": [
    { "name": "a name", "input": { "value": "chrome.exe", "os": "windows" }, "expected": "name" },
    { "name": "a name with a space", "input": { "value": "Adobe Reader.exe", "os": "windows" }, "expected": "name" },
    { "name": "a linux name", "input": { "value": "org.example.app", "os": "linux" }, "expected": "name" },
    { "name": "a name glob", "input": { "value": "*vpn*.exe", "os": "windows" }, "expected": "name-glob" },
    { "name": "a name glob +children", "input": { "value": "nord* +children", "os": "windows" }, "expected": "name-glob" },
    { "name": "a backslash is part of a linux name", "input": { "value": "odd\\name", "os": "linux" }, "expected": "name" },
    { "name": "windows file", "input": { "value": "C:\\Apps\\Tool\\tool.exe", "os": "windows" }, "expected": "file" },
    { "name": "windows file, any case of the suffix", "input": { "value": "C:\\Apps\\Tool\\Tool.EXE", "os": "windows" }, "expected": "file" },
    { "name": "windows file with forward slashes", "input": { "value": "C:/Apps/Tool/tool.exe", "os": "windows" }, "expected": "file" },
    { "name": "windows file whose name ends in dots", "input": { "value": "C:\\Apps\\tool.exe. ", "os": "windows" }, "expected": "file" },
    { "name": "windows file +children", "input": { "value": "C:\\Apps\\tool.exe +children", "os": "windows" }, "expected": "file" },
    { "name": "windows folder without the trailing backslash", "input": { "value": "C:\\Apps\\Tool", "os": "windows" }, "expected": "folder" },
    { "name": "windows folder with the trailing backslash", "input": { "value": "C:\\Program Files\\Example App\\", "os": "windows" }, "expected": "folder" },
    { "name": "windows folder named like a program, trailing backslash", "input": { "value": "C:\\Apps\\tool.exe\\", "os": "windows" }, "expected": "folder" },
    { "name": "windows disk root", "input": { "value": "C:\\", "os": "windows" }, "expected": "folder" },
    { "name": "windows share root", "input": { "value": "\\\\server\\share", "os": "windows" }, "expected": "folder" },
    { "name": "windows share folder", "input": { "value": "\\\\server\\share\\tools\\", "os": "windows" }, "expected": "folder" },
    { "name": "windows long-path prefix", "input": { "value": "\\\\?\\C:\\Apps\\tool.exe", "os": "windows" }, "expected": "file" },
    { "name": "windows folder with subfolders", "input": { "value": "C:\\Apps\\*", "os": "windows" }, "expected": "folder-tree" },
    { "name": "windows folder with subfolders, forward slash", "input": { "value": "C:/Apps/*", "os": "windows" }, "expected": "folder-tree" },
    { "name": "windows disk with subfolders", "input": { "value": "C:\\*", "os": "windows" }, "expected": "folder-tree" },
    { "name": "windows tree +children", "input": { "value": "C:\\Apps\\* +children", "os": "windows" }, "expected": "folder-tree" },
    { "name": "windows tree +override", "input": { "value": "C:\\Apps\\* +override", "os": "windows" }, "expected": "folder-tree" },
    { "name": "linux tree +children +override", "input": { "value": "/var/www/* +children +override", "os": "linux" }, "expected": "folder-tree" },
    { "name": "linux path without a trailing slash waits for the disk", "input": { "value": "/opt/tool/bin/tool", "os": "linux" }, "expected": "file-or-folder" },
    { "name": "linux folder", "input": { "value": "/opt/tool/", "os": "linux" }, "expected": "folder" },
    { "name": "linux folder with subfolders", "input": { "value": "/opt/tool/*", "os": "linux" }, "expected": "folder-tree" },
    { "name": "linux root", "input": { "value": "/", "os": "linux" }, "expected": "folder" },
    { "name": "macos bundle with subfolders", "input": { "value": "/Applications/Example.app/*", "os": "macos" }, "expected": "folder-tree" },
    { "name": "macos path without a trailing slash", "input": { "value": "/Applications/Example.app", "os": "macos" }, "expected": "file-or-folder" },
    { "name": "star inside a windows path", "input": { "value": "C:\\Apps\\*.exe", "os": "windows" }, "expected": "path-star" },
    { "name": "star as a middle segment", "input": { "value": "C:\\*\\tool.exe", "os": "windows" }, "expected": "path-star" },
    { "name": "star glued to a name in a path", "input": { "value": "C:\\Apps\\nord*", "os": "windows" }, "expected": "path-star" },
    { "name": "two stars at the end", "input": { "value": "C:\\Apps\\**", "os": "windows" }, "expected": "path-star" },
    { "name": "star before a trailing backslash", "input": { "value": "C:\\Apps\\*\\", "os": "windows" }, "expected": "path-star" },
    { "name": "star inside a linux path", "input": { "value": "/opt/*/bin", "os": "linux" }, "expected": "path-star" },
    { "name": "relative windows path", "input": { "value": "Apps\\tool.exe", "os": "windows" }, "expected": "path-not-absolute" },
    { "name": "drive-relative windows path", "input": { "value": "C:Apps\\tool.exe", "os": "windows" }, "expected": "path-not-absolute" },
    { "name": "a linux path on windows", "input": { "value": "/usr/bin/tool", "os": "windows" }, "expected": "path-not-absolute" },
    { "name": "relative linux path", "input": { "value": "bin/tool", "os": "linux" }, "expected": "path-not-absolute" },
    { "name": "home-relative linux path waits for the disk", "input": { "value": "~/bin/tool", "os": "linux" }, "expected": "file-or-folder" },
    { "name": "linux home folder with subfolders", "input": { "value": "~/apps/*", "os": "linux" }, "expected": "folder-tree" },
    { "name": "the linux home folder with its slash", "input": { "value": "~/", "os": "linux" }, "expected": "folder" },
    { "name": "a tilde without a slash is a name", "input": { "value": "~", "os": "linux" }, "expected": "name" },
    { "name": "macos home folder", "input": { "value": "~/Apps/", "os": "macos" }, "expected": "folder" },
    { "name": "another user's home is not a variable", "input": { "value": "~bob/apps/", "os": "linux" }, "expected": "path-unknown-variable" },
    { "name": "a shell variable is not read", "input": { "value": "$HOME/apps/", "os": "linux" }, "expected": "path-unknown-variable" },
    { "name": "a windows variable on linux", "input": { "value": "%LOCALAPPDATA%/apps/", "os": "linux" }, "expected": "path-unknown-variable" },
    { "name": "windows local app data with subfolders", "input": { "value": "%LOCALAPPDATA%\\Discord\\*", "os": "windows" }, "expected": "folder-tree" },
    { "name": "windows roaming app data, any case", "input": { "value": "%AppData%\\Tool", "os": "windows" }, "expected": "folder" },
    { "name": "windows profile file", "input": { "value": "%USERPROFILE%/Apps/tool.exe", "os": "windows" }, "expected": "file" },
    { "name": "windows local app data with its backslash", "input": { "value": "%LOCALAPPDATA%\\", "os": "windows" }, "expected": "folder" },
    { "name": "an unknown windows variable", "input": { "value": "%TEMP%\\app.exe", "os": "windows" }, "expected": "path-unknown-variable" },
    { "name": "an unclosed windows variable", "input": { "value": "%LOCALAPPDATA\\app.exe", "os": "windows" }, "expected": "path-unknown-variable" },
    { "name": "a variable glued to a name", "input": { "value": "%APPDATA%x\\app.exe", "os": "windows" }, "expected": "path-unknown-variable" },
    { "name": "a tilde on windows", "input": { "value": "~\\apps\\", "os": "windows" }, "expected": "path-unknown-variable" },
    { "name": "a profile path climbing up", "input": { "value": "%LOCALAPPDATA%\\..\\x\\", "os": "windows" }, "expected": "path-invalid" },
    { "name": "star inside a profile path", "input": { "value": "~/apps/*.sh", "os": "linux" }, "expected": "path-star" },
    { "name": "a windows name with percents stays a name", "input": { "value": "%odd%.exe", "os": "windows" }, "expected": "name" },
    { "name": "a windows path on linux", "input": { "value": "C:/Apps/tool.exe", "os": "linux" }, "expected": "path-not-absolute" },
    { "name": "windows path climbing up", "input": { "value": "C:\\Apps\\..\\Windows\\", "os": "windows" }, "expected": "path-invalid" },
    { "name": "colon inside a windows segment", "input": { "value": "C:\\Apps\\a:b\\", "os": "windows" }, "expected": "path-invalid" },
    { "name": "a share without its name", "input": { "value": "\\\\server", "os": "windows" }, "expected": "path-invalid" },
    { "name": "a segment of dots only", "input": { "value": "C:\\Apps\\...\\", "os": "windows" }, "expected": "path-invalid" },
    { "name": "linux path climbing up", "input": { "value": "/opt/../etc/", "os": "linux" }, "expected": "path-invalid" },
    { "name": "a line break the +children flag would join away", "input": { "value": "C:\\Apps\\to\nol.exe +children", "os": "windows" }, "expected": "path-invalid" },
    { "name": "a control character","input": { "value": "C:\\Apps\\to\u0007ol.exe", "os": "windows" }, "expected": "path-invalid" },
    { "name": "deeper than a path may be", "input": { "value": "", "os": "linux" }, "expected": "path-invalid" }
  ]
}
