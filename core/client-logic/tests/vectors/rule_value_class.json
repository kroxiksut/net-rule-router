{
  "description": "rules.js ruleValueClass / nrr_shared::rule_value_class::classify_rule_value: what kind of rule a value is, by its spelling alone",
  "cases": [
    { "name": "ipv4", "input": { "value": "192.0.2.7" }, "expected": "address" },
    { "name": "ipv4 padded", "input": { "value": " 192.0.2.7 " }, "expected": "address" },
    { "name": "ipv4 octet out of range", "input": { "value": "300.1.1.1" }, "expected": "address" },
    { "name": "ipv4 short", "input": { "value": "1.2.3" }, "expected": "address" },
    { "name": "dotted quad typo", "input": { "value": "1.2.3.x" }, "expected": "address" },
    { "name": "ipv6", "input": { "value": "2001:db8::7" }, "expected": "address" },
    { "name": "ipv6 zone index", "input": { "value": "fe80::1%3" }, "expected": "address" },
    { "name": "subnet", "input": { "value": "10.0.0.0/24" }, "expected": "subnet" },
    { "name": "subnet prefix out of range", "input": { "value": "10.0.0.0/33" }, "expected": "subnet" },
    { "name": "ipv6 subnet spaced", "input": { "value": "2001:db8:: / 48" }, "expected": "subnet" },
    { "name": "range", "input": { "value": "192.0.2.10-192.0.2.40" }, "expected": "range" },
    { "name": "range spaced", "input": { "value": "192.0.2.100 - 192.0.2.120" }, "expected": "range" },
    { "name": "ipv6 range", "input": { "value": "2001:db8::1-2001:db8::ff" }, "expected": "range" },
    { "name": "zone wildcard", "input": { "value": "*.ru" }, "expected": "zone" },
    { "name": "zone leading dot", "input": { "value": ".ru" }, "expected": "zone" },
    { "name": "zone idn", "input": { "value": "*.рф" }, "expected": "zone" },
    { "name": "host", "input": { "value": "example.com" }, "expected": "host" },
    { "name": "host fully qualified", "input": { "value": "example.com." }, "expected": "host" },
    { "name": "host idn", "input": { "value": "пример.рф" }, "expected": "host" },
    { "name": "host ace", "input": { "value": "xn--e1afmkfd.xn--p1ai" }, "expected": "host" },
    { "name": "sh is a top-level domain", "input": { "value": "deploy.sh" }, "expected": "host" },
    { "name": "app is a top-level domain", "input": { "value": "example.app" }, "expected": "host" },
    { "name": "host behind no-break spaces", "input": { "value": "\u00a0example.com\u00a0" }, "expected": "host" },
    { "name": "subdomains", "input": { "value": "*.example.com" }, "expected": "host-with-subdomains" },
    { "name": "site in every zone", "input": { "value": "example.*" }, "expected": "site-in-every-zone" },
    { "name": "site in every zone with subdomains", "input": { "value": "*.example.*" }, "expected": "site-in-every-zone" },
    { "name": "version glob reads as every zone", "input": { "value": "python3.*" }, "expected": "site-in-every-zone" },
    { "name": "exe", "input": { "value": "chrome.exe" }, "expected": "application" },
    { "name": "exe upper case", "input": { "value": "Chrome.EXE" }, "expected": "application" },
    { "name": "exe glob", "input": { "value": "*vpn*.exe" }, "expected": "application" },
    { "name": "exe alone", "input": { "value": ".exe" }, "expected": "application" },
    { "name": "trailing glob", "input": { "value": "nord*" }, "expected": "application" },
    { "name": "leading glob", "input": { "value": "*torrent" }, "expected": "application" },
    { "name": "windows path", "input": { "value": "C:\\Program Files\\app" }, "expected": "application" },
    { "name": "windows path forward slashes", "input": { "value": "C:/Apps/tool" }, "expected": "application" },
    { "name": "unix path", "input": { "value": "/usr/bin/app" }, "expected": "application" },
    { "name": "relative path", "input": { "value": "./run" }, "expected": "application" },
    { "name": "one word", "input": { "value": "telegram" }, "expected": "ambiguous" },
    { "name": "one word with hyphen", "input": { "value": "corp-internal" }, "expected": "ambiguous" },
    { "name": "tld alone", "input": { "value": "ru" }, "expected": "ambiguous" },
    { "name": "ace label alone", "input": { "value": "xn--p1ai" }, "expected": "ambiguous" },
    { "name": "digits alone", "input": { "value": "1234" }, "expected": "ambiguous" },
    { "name": "empty", "input": { "value": "" }, "expected": "unrecognized" },
    { "name": "a lone dot is no address", "input": { "value": "." }, "expected": "unrecognized" },
    { "name": "dots only are no address", "input": { "value": ".." }, "expected": "unrecognized" },
    { "name": "blank", "input": { "value": "   " }, "expected": "unrecognized" },
    { "name": "script suffix is no tld", "input": { "value": "script.ps1" }, "expected": "unrecognized" },
    { "name": "version suffix", "input": { "value": "python3.11" }, "expected": "unrecognized" },
    { "name": "spaced program name", "input": { "value": "Some App.app" }, "expected": "unrecognized" },
    { "name": "interior glob", "input": { "value": "foo.*.bar" }, "expected": "unrecognized" },
    { "name": "glob glued to a name", "input": { "value": "*example.com" }, "expected": "unrecognized" },
    { "name": "bare star", "input": { "value": "*" }, "expected": "unrecognized" },
    { "name": "stars", "input": { "value": "**" }, "expected": "unrecognized" },
    { "name": "star dot", "input": { "value": "*." }, "expected": "unrecognized" },
    { "name": "url path", "input": { "value": "example.com/page" }, "expected": "unrecognized" },
    { "name": "url", "input": { "value": "https://example.com/" }, "expected": "unrecognized" },
    { "name": "label edged with hyphen", "input": { "value": "-bad.example" }, "expected": "unrecognized" },
    { "name": "zone with both dots", "input": { "value": ".ru." }, "expected": "unrecognized" },
    { "name": "one colon", "input": { "value": "a:b" }, "expected": "unrecognized" },
    { "name": "byte order mark is not trimmed", "input": { "value": "\ufeffexample.com" }, "expected": "unrecognized" }
  ]
}
