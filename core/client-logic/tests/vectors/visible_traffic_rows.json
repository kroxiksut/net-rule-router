{
  "description": "pure.js visibleTrafficRows: virtual rows hidden while the count is off",
  "cases": [
    { "name": "off hides virtual", "input": { "rows": [{ "adapter-key": "Ethernet", "display-name": "Ethernet", "role": "primary", "in-bytes": 5, "out-bytes": 6 }, { "adapter-key": "VMnet8", "display-name": "VMnet8", "role": "virtual", "in-bytes": 3, "out-bytes": 4 }], "countVirtual": false }, "expected": [{ "adapter-key": "Ethernet", "display-name": "Ethernet", "role": "primary", "in-bytes": 5, "out-bytes": 6 }] },
    { "name": "on keeps virtual", "input": { "rows": [{ "adapter-key": "Ethernet", "display-name": "Ethernet", "role": "primary", "in-bytes": 5, "out-bytes": 6 }, { "adapter-key": "VMnet8", "display-name": "VMnet8", "role": "virtual", "in-bytes": 3, "out-bytes": 4 }], "countVirtual": true }, "expected": [{ "adapter-key": "Ethernet", "display-name": "Ethernet", "role": "primary", "in-bytes": 5, "out-bytes": 6 }, { "adapter-key": "VMnet8", "display-name": "VMnet8", "role": "virtual", "in-bytes": 3, "out-bytes": 4 }] },
    { "name": "off hides every virtual row", "input": { "rows": [{ "adapter-key": "VMnet8", "display-name": "VMnet8", "role": "virtual", "in-bytes": 3, "out-bytes": 4 }, { "adapter-key": "Ethernet", "display-name": "Ethernet", "role": "primary", "in-bytes": 5, "out-bytes": 6 }, { "adapter-key": "vEthernet", "display-name": "vEthernet", "role": "virtual", "in-bytes": 7, "out-bytes": 8 }, { "adapter-key": "VPN", "display-name": "VPN", "role": "secondary", "in-bytes": 9, "out-bytes": 9 }], "countVirtual": false }, "expected": [{ "adapter-key": "Ethernet", "display-name": "Ethernet", "role": "primary", "in-bytes": 5, "out-bytes": 6 }, { "adapter-key": "VPN", "display-name": "VPN", "role": "secondary", "in-bytes": 9, "out-bytes": 9 }] },
    { "name": "on keeps order", "input": { "rows": [{ "adapter-key": "VMnet8", "display-name": "VMnet8", "role": "virtual", "in-bytes": 3, "out-bytes": 4 }, { "adapter-key": "Ethernet", "display-name": "Ethernet", "role": "primary", "in-bytes": 5, "out-bytes": 6 }, { "adapter-key": "vEthernet", "display-name": "vEthernet", "role": "virtual", "in-bytes": 7, "out-bytes": 8 }, { "adapter-key": "VPN", "display-name": "VPN", "role": "secondary", "in-bytes": 9, "out-bytes": 9 }], "countVirtual": true }, "expected": [{ "adapter-key": "VMnet8", "display-name": "VMnet8", "role": "virtual", "in-bytes": 3, "out-bytes": 4 }, { "adapter-key": "Ethernet", "display-name": "Ethernet", "role": "primary", "in-bytes": 5, "out-bytes": 6 }, { "adapter-key": "vEthernet", "display-name": "vEthernet", "role": "virtual", "in-bytes": 7, "out-bytes": 8 }, { "adapter-key": "VPN", "display-name": "VPN", "role": "secondary", "in-bytes": 9, "out-bytes": 9 }] },
    { "name": "off keeps loopback", "input": { "rows": [{ "adapter-key": "lo", "display-name": "lo", "role": "loopback", "in-bytes": 1, "out-bytes": 1 }, { "adapter-key": "VMnet8", "display-name": "VMnet8", "role": "virtual", "in-bytes": 3, "out-bytes": 4 }], "countVirtual": false }, "expected": [{ "adapter-key": "lo", "display-name": "lo", "role": "loopback", "in-bytes": 1, "out-bytes": 1 }] },
    { "name": "off with only virtual", "input": { "rows": [{ "adapter-key": "VMnet8", "display-name": "VMnet8", "role": "virtual", "in-bytes": 3, "out-bytes": 4 }, { "adapter-key": "vEthernet", "display-name": "vEthernet", "role": "virtual", "in-bytes": 7, "out-bytes": 8 }], "countVirtual": false }, "expected": [] },
    { "name": "on with only virtual", "input": { "rows": [{ "adapter-key": "VMnet8", "display-name": "VMnet8", "role": "virtual", "in-bytes": 3, "out-bytes": 4 }, { "adapter-key": "vEthernet", "display-name": "vEthernet", "role": "virtual", "in-bytes": 7, "out-bytes": 8 }], "countVirtual": true }, "expected": [{ "adapter-key": "VMnet8", "display-name": "VMnet8", "role": "virtual", "in-bytes": 3, "out-bytes": 4 }, { "adapter-key": "vEthernet", "display-name": "vEthernet", "role": "virtual", "in-bytes": 7, "out-bytes": 8 }] },
    { "name": "off with no rows", "input": { "rows": [], "countVirtual": false }, "expected": [] },
    { "name": "on with no rows", "input": { "rows": [], "countVirtual": true }, "expected": [] },
    { "name": "off keeps routed roles", "input": { "rows": [{ "adapter-key": "VPN", "display-name": "VPN", "role": "secondary", "in-bytes": 9, "out-bytes": 9 }, { "adapter-key": "Ethernet", "display-name": "Ethernet", "role": "primary", "in-bytes": 5, "out-bytes": 6 }, { "adapter-key": "lo", "display-name": "lo", "role": "loopback", "in-bytes": 1, "out-bytes": 1 }], "countVirtual": false }, "expected": [{ "adapter-key": "VPN", "display-name": "VPN", "role": "secondary", "in-bytes": 9, "out-bytes": 9 }, { "adapter-key": "Ethernet", "display-name": "Ethernet", "role": "primary", "in-bytes": 5, "out-bytes": 6 }, { "adapter-key": "lo", "display-name": "lo", "role": "loopback", "in-bytes": 1, "out-bytes": 1 }] }
  ]
}
