{
  "description": "pure.js globMatch / nrr_shared::glob::glob_match: `*` is the only wildcard, letters fold under per-code-point Unicode lowercasing (final sigma folds to sigma), the rest is exact",
  "cases": [
    { "name": "exact", "input": { "pattern": "vbox.exe", "text": "vbox.exe" }, "expected": true },
    { "name": "case folds", "input": { "pattern": "VBox.EXE", "text": "vbox.exe" }, "expected": true },
    { "name": "trailing star", "input": { "pattern": "vbox*.exe", "text": "VBoxHeadless.exe" }, "expected": true },
    { "name": "star matches nothing", "input": { "pattern": "vbox*.exe", "text": "vbox.exe" }, "expected": true },
    { "name": "star only", "input": { "pattern": "*", "text": "anything" }, "expected": true },
    { "name": "star on empty", "input": { "pattern": "*", "text": "" }, "expected": true },
    { "name": "empty pattern", "input": { "pattern": "", "text": "a" }, "expected": false },
    { "name": "both empty", "input": { "pattern": "", "text": "" }, "expected": true },
    { "name": "question mark is literal", "input": { "pattern": "a?c", "text": "abc" }, "expected": false },
    { "name": "question mark matches itself", "input": { "pattern": "a?c", "text": "a?c" }, "expected": true },
    { "name": "star crosses separators", "input": { "pattern": "c:\\tools\\*.exe", "text": "C:\\Tools\\sub\\x.exe" }, "expected": true },
    { "name": "backtracking", "input": { "pattern": "*a*a*b", "text": "aaaab" }, "expected": true },
    { "name": "backtracking fails", "input": { "pattern": "*a*a*b", "text": "aaaa" }, "expected": false },
    { "name": "prefix is not enough", "input": { "pattern": "vbox", "text": "vbox.exe" }, "expected": false },
    { "name": "latin-1 folds", "input": { "pattern": "É.exe", "text": "é.exe" }, "expected": true },
    { "name": "latin-1 differs", "input": { "pattern": "é", "text": "e" }, "expected": false },
    { "name": "non-ascii exact", "input": { "pattern": "é*.exe", "text": "éa.exe" }, "expected": true },
    { "name": "star then non-ascii", "input": { "pattern": "*é", "text": "aé" }, "expected": true },
    { "name": "star over non-ascii text", "input": { "pattern": "*.exe", "text": "Программа.exe" }, "expected": true },
    { "name": "cyrillic folds", "input": { "pattern": "ПРОГРАММА.exe", "text": "программа.EXE" }, "expected": true },
    { "name": "cyrillic star folds", "input": { "pattern": "*Редактор*", "text": "мой редактор.exe" }, "expected": true },
    { "name": "cyrillic differs", "input": { "pattern": "а", "text": "б" }, "expected": false },
    { "name": "sigma folds", "input": { "pattern": "Σ", "text": "σ" }, "expected": true },
    { "name": "final sigma folds to sigma", "input": { "pattern": "ΟΔΟΣ", "text": "οδος" }, "expected": true },
    { "name": "final sigma pattern", "input": { "pattern": "οδος", "text": "ΟΔΟΣ" }, "expected": true },
    { "name": "sharp s is not ss", "input": { "pattern": "ß", "text": "SS" }, "expected": false },
    { "name": "capital sharp s folds to sharp s", "input": { "pattern": "ß", "text": "ẞ" }, "expected": true },
    { "name": "dotted capital i is not i", "input": { "pattern": "İ", "text": "i" }, "expected": false },
    { "name": "dotted capital i folds with itself", "input": { "pattern": "İ.exe", "text": "İ.EXE" }, "expected": true },
    { "name": "kelvin sign folds to k", "input": { "pattern": "k", "text": "K" }, "expected": true },
    { "name": "astral exact", "input": { "pattern": "a😀*", "text": "A😀b" }, "expected": true },
    { "name": "star steps over astral", "input": { "pattern": "*b", "text": "😀😀b" }, "expected": true },
    { "name": "astral differs", "input": { "pattern": "😀", "text": "😁" }, "expected": false }
  ]
}
