{
  "description": "nrr_shared::display_text and pure.js displayText: a foreign name made safe to show. Input and expected are a `text` string or `pieces`, a list of [string, repeat count] joined in order.",
  "cases": [
    { "name": "empty", "input": { "text": "" }, "expected": "" },
    { "name": "plain ASCII name", "input": { "text": "app.exe" }, "expected": "app.exe" },
    { "name": "Windows path", "input": { "text": "C:\\Program Files\\Example\\example.exe" }, "expected": "C:\\Program Files\\Example\\example.exe" },
    { "name": "OSC 52 clipboard write: ESC and BEL", "input": { "text": "\u001b]52;c;aGk=\u0007" }, "expected": "\u00b7]52;c;aGk=\u00b7" },
    { "name": "CSI as ESC [ and as the 8-bit C1 byte", "input": { "text": "a\u001b[2Jb\u009b2J" }, "expected": "a\u00b7[2Jb\u00b72J" },
    { "name": "NUL, DEL, NEL, tab, CR and LF", "input": { "text": "\u0000x\u007f\u0085\t\r\n" }, "expected": "\u00b7x\u00b7\u00b7\u00b7\u00b7\u00b7" },
    { "name": "right-to-left override reverses an extension", "input": { "text": "gnp\u202e.exe" }, "expected": "gnp\u00b7.exe" },
    { "name": "embeddings, isolates and marks", "input": { "text": "\u202aa\u202b\u202cb\u2066c\u2067d\u2068e\u2069\u200e\u200f\u061c" }, "expected": "\u00b7a\u00b7\u00b7b\u00b7c\u00b7d\u00b7e\u00b7\u00b7\u00b7\u00b7" },
    { "name": "zero-width space, joiners and BOM", "input": { "text": "\ufeffexa\u200bmp\u200cl\u200de\u2060" }, "expected": "\u00b7exa\u00b7mp\u00b7l\u00b7e\u00b7" },
    { "name": "soft hyphen, grapheme joiner, Mongolian vowel separator", "input": { "text": "a\u00adb\u034fc\u180ed" }, "expected": "a\u00b7b\u00b7c\u00b7d" },
    { "name": "invisible operators and deprecated format controls", "input": { "text": "x\u2061\u2062\u2063\u2064\u206a\u206f" }, "expected": "x\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7" },
    { "name": "letters that draw nothing", "input": { "text": "\u3164\uffa0\u115f\u1160" }, "expected": "\u00b7\u00b7\u00b7\u00b7" },
    { "name": "line and paragraph separators", "input": { "text": "a\u2028b\u2029c" }, "expected": "a\u00b7b\u00b7c" },
    { "name": "interlinear annotation hides its text", "input": { "text": "ok\ufff9hidden\ufffa\ufffb" }, "expected": "ok\u00b7hidden\u00b7\u00b7" },
    { "name": "tag characters and supplementary variation selectors", "input": { "text": "t\udb40\udc01\udb40\udc41\udb40\udc7f\udb40\udd00\udb40\uddef" }, "expected": "t\u00b7\u00b7\u00b7\u00b7\u00b7" },
    { "name": "shorthand and musical format controls", "input": { "text": "\ud82f\udca0\ud834\udd73" }, "expected": "\u00b7\u00b7" },
    { "name": "combining marks stay", "input": { "text": "e\u0301 \u0438\u0306 \u0928\u093f\u0915" }, "expected": "e\u0301 \u0438\u0306 \u0928\u093f\u0915" },
    { "name": "emoji presentation selector stays", "input": { "text": "\u2764\ufe0f \u2603\ufe0e" }, "expected": "\u2764\ufe0f \u2603\ufe0e" },
    { "name": "Cyrillic name unchanged", "input": { "text": "Программа обновления.exe" }, "expected": "Программа обновления.exe" },
    { "name": "CJK name unchanged", "input": { "text": "程序管理器.exe" }, "expected": "程序管理器.exe" },
    { "name": "Arabic name unchanged", "input": { "text": "برنامج الشبكة" }, "expected": "برنامج الشبكة" },
    { "name": "Arabic number sign draws a visible mark and stays", "input": { "text": "\u0600123" }, "expected": "\u0600123" },
    { "name": "spaces of other widths stay", "input": { "text": "a\u00a0b\u3000c" }, "expected": "a\u00a0b\u3000c" },
    { "name": "exactly the cap is left whole", "input": { "pieces": [["a", 512]] }, "expected": { "pieces": [["a", 512]] } },
    { "name": "one past the cap keeps both ends", "input": { "pieces": [["a", 513]] }, "expected": { "pieces": [["a", 255], ["\u2026", 1], ["a", 256]] } },
    { "name": "the cut keeps the folder and the file name", "input": { "pieces": [["C:\\", 1], ["d\\", 400], ["name.exe", 1]] }, "expected": { "pieces": [["C:\\", 1], ["d\\", 126], ["\u2026", 1], ["d\\", 124], ["name.exe", 1]] } },
    { "name": "a long name is counted in code points, not UTF-16 units", "input": { "pieces": [["\ud83d\ude00", 600]] }, "expected": { "pieces": [["\ud83d\ude00", 255], ["\u2026", 1], ["\ud83d\ude00", 256]] } },
    { "name": "a long name is still substituted on both sides of the cut", "input": { "pieces": [["я", 254], ["\u202e", 1], ["б", 300], ["\u001b", 1], ["в", 10]] }, "expected": { "pieces": [["я", 254], ["\u00b7", 1], ["\u2026", 1], ["б", 245], ["\u00b7", 1], ["в", 10]] } },
    { "name": "a forbidden supplementary character on the cut", "input": { "pieces": [["a", 255], ["\udb40\udc41", 300]] }, "expected": { "pieces": [["a", 255], ["\u2026", 1], ["\u00b7", 256]] } }
  ]
}
