{
  "description": "pure.js fullResetNext: the order of a full reset and what each step's result decides",
  "cases": [
    {
      "name": "first step",
      "input": { "canElevate": false, "done": [] },
      "expected": { "action": "run", "step": "clear-logs", "cleared": false, "why": "" }
    },
    {
      "name": "sidecar after logs",
      "input": { "canElevate": false, "done": [{ "step": "clear-logs", "result": "ok" }] },
      "expected": { "action": "run", "step": "reset-sidecar", "cleared": false, "why": "" }
    },
    {
      "name": "refused log clear does not stop",
      "input": { "canElevate": false, "done": [{ "step": "clear-logs", "result": "forbidden" }] },
      "expected": { "action": "run", "step": "reset-sidecar", "cleared": false, "why": "" }
    },
    {
      "name": "purge after a skipped sidecar",
      "input": {
        "canElevate": false,
        "done": [
          { "step": "clear-logs", "result": "ok" },
          { "step": "reset-sidecar", "result": "skipped" }
        ]
      },
      "expected": { "action": "run", "step": "purge-principal-data", "cleared": false, "why": "" }
    },
    {
      "name": "refused purge without elevation stops",
      "input": {
        "canElevate": false,
        "done": [
          { "step": "clear-logs", "result": "ok" },
          { "step": "reset-sidecar", "result": "skipped" },
          { "step": "purge-principal-data", "result": "forbidden" }
        ]
      },
      "expected": { "action": "stop", "step": "purge-principal-data", "cleared": false, "why": "needs-elevation" }
    },
    {
      "name": "refused purge with elevation goes on",
      "input": {
        "canElevate": true,
        "done": [
          { "step": "clear-logs", "result": "ok" },
          { "step": "reset-sidecar", "result": "ok" },
          { "step": "purge-principal-data", "result": "forbidden" }
        ]
      },
      "expected": { "action": "run", "step": "stop-service", "cleared": false, "why": "" }
    },
    {
      "name": "failed purge goes on to the service stop",
      "input": {
        "canElevate": false,
        "done": [
          { "step": "clear-logs", "result": "ok" },
          { "step": "reset-sidecar", "result": "ok" },
          { "step": "purge-principal-data", "result": "failed" }
        ]
      },
      "expected": { "action": "run", "step": "stop-service", "cleared": false, "why": "" }
    },
    {
      "name": "service stop follows the purge: no rule book of the user's own is written",
      "input": {
        "canElevate": false,
        "done": [
          { "step": "clear-logs", "result": "ok" },
          { "step": "reset-sidecar", "result": "ok" },
          { "step": "purge-principal-data", "result": "ok" }
        ]
      },
      "expected": { "action": "run", "step": "stop-service", "cleared": false, "why": "" }
    },
    {
      "name": "everything cleared",
      "input": {
        "canElevate": false,
        "done": [
          { "step": "clear-logs", "result": "failed" },
          { "step": "reset-sidecar", "result": "skipped" },
          { "step": "purge-principal-data", "result": "ok" },
          { "step": "stop-service", "result": "ok" }
        ]
      },
      "expected": { "action": "finish", "step": "", "cleared": true, "why": "" }
    },
    {
      "name": "failed stop is not cleared",
      "input": {
        "canElevate": true,
        "done": [
          { "step": "clear-logs", "result": "ok" },
          { "step": "reset-sidecar", "result": "ok" },
          { "step": "purge-principal-data", "result": "ok" },
          { "step": "stop-service", "result": "failed" }
        ]
      },
      "expected": { "action": "finish", "step": "", "cleared": false, "why": "" }
    }
  ]
}
