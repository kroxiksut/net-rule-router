{
  "description": "rules.js ruleRowToWireDto: a table row as a canonical wire RuleDto. `encode` passes the harness IDN stand-in (non-ASCII gains `ace:`, `ace-fails.example` encodes to nothing). A row the wire refuses answers `{ refused: <client error code> }`.",
  "cases": [
    { "name": "exact-fqdn", "input": { "row": { "id": "R-0001", "enabled": true, "ruleType": "exact-fqdn", "matchValue": "api.example", "targetRoute": "primary", "comment": "" } } },
    { "name": "suffix-domain strips the star prefix", "input": { "row": { "id": "R-0002", "enabled": true, "ruleType": "suffix-domain", "matchValue": "*.video.example", "targetRoute": "secondary", "comment": "media" } } },
    { "name": "suffix-domain without prefix", "input": { "row": { "id": "R-0003", "enabled": false, "ruleType": "suffix-domain", "matchValue": "video.example", "targetRoute": "secondary" } } },
    { "name": "domain with star is a suffix", "input": { "row": { "id": "R-0004", "enabled": true, "ruleType": "domain", "matchValue": "*.cdn.example", "targetRoute": "secondary" } } },
    { "name": "domain without star is exact", "input": { "row": { "id": "R-0005", "enabled": true, "ruleType": "domain", "matchValue": "cdn.example", "targetRoute": "primary" } } },
    { "name": "zone encoded", "input": { "row": { "id": "R-0006", "enabled": true, "ruleType": "zone", "matchValue": "рф", "targetRoute": "primary" }, "encode": true } },
    { "name": "IDN host encoded", "input": { "row": { "id": "R-0007", "enabled": true, "ruleType": "domain", "matchValue": "*.пример.рф", "targetRoute": "secondary" }, "encode": true } },
    { "name": "encoder answering nothing keeps the value", "input": { "row": { "id": "R-0008", "enabled": true, "ruleType": "exact-fqdn", "matchValue": "ace-fails.example", "targetRoute": "primary" }, "encode": true } },
    { "name": "non-host type is not encoded", "input": { "row": { "id": "R-0009", "enabled": true, "ruleType": "application", "matchValue": "приложение.exe", "targetRoute": "secondary" }, "encode": true } },
    { "name": "exact-ip v4", "input": { "row": { "id": "R-0010", "enabled": true, "ruleType": "exact-ip", "matchValue": "192.0.2.7", "targetRoute": "secondary" } } },
    { "name": "exact-ipv4 slug with v6 text", "input": { "row": { "id": "R-0011", "enabled": true, "ruleType": "exact-ipv4", "matchValue": "2001:db8::7", "targetRoute": "secondary" } } },
    { "name": "subnet trimmed", "input": { "row": { "id": "R-0012", "enabled": true, "ruleType": "subnet", "matchValue": "  198.51.100.0/24 ", "targetRoute": "secondary" } } },
    { "name": "range split at the dash", "input": { "row": { "id": "R-0013", "enabled": true, "ruleType": "ip-range", "matchValue": "192.0.2.10 - 192.0.2.20", "targetRoute": "primary" } } },
    { "name": "range without a dash", "input": { "row": { "id": "R-0014", "enabled": true, "ruleType": "ip-range", "matchValue": " 192.0.2.10 ", "targetRoute": "primary" } } },
    { "name": "application glob", "input": { "row": { "id": "R-0015", "enabled": true, "ruleType": "application", "matchValue": "disko*.exe", "targetRoute": "secondary" } } },
    { "name": "application exact", "input": { "row": { "id": "R-0016", "enabled": true, "ruleType": "application", "matchValue": "client.exe", "targetRoute": "primary" } } },
    { "name": "application +children sends the bare name", "input": { "row": { "id": "R-0022", "enabled": true, "ruleType": "application", "matchValue": "codex.exe +children", "targetRoute": "secondary" } } },
    { "name": "application glob +children denied", "input": { "row": { "id": "R-0023", "enabled": false, "ruleType": "application", "matchValue": "tool*.exe  +children", "targetRoute": "block" } } },
    { "name": "application file path is a path", "input": { "row": { "id": "R-0030", "enabled": true, "ruleType": "application", "matchValue": "C:\\Apps\\Tool\\tool.exe", "targetRoute": "secondary" } }, "expected": { "id": "R-0030", "enabled": true, "app-match": { "pattern": { "kind": "path", "value": "C:\\Apps\\Tool\\tool.exe" }, "include-child-processes": false } } },
    { "name": "application folder is a path", "input": { "row": { "id": "R-0031", "enabled": true, "ruleType": "application", "matchValue": "C:\\Program Files\\Example App\\", "targetRoute": "primary" } } },
    { "name": "application folder with subfolders is a path, not a glob", "input": { "row": { "id": "R-0032", "enabled": true, "ruleType": "application", "matchValue": "C:\\Apps\\*", "targetRoute": "block" } }, "expected": { "id": "R-0032", "enabled": true, "app-match": { "pattern": { "kind": "path", "value": "C:\\Apps\\*" }, "include-child-processes": false }, "action": "block" } },
    { "name": "unix folder +children sends the bare path", "input": { "row": { "id": "R-0033", "enabled": true, "ruleType": "application", "matchValue": "/opt/tool/* +children", "targetRoute": "secondary" } }, "expected": { "id": "R-0033", "enabled": true, "app-match": { "pattern": { "kind": "path", "value": "/opt/tool/*" }, "include-child-processes": false } } },
    { "name": "unix folder +override sends the bare path and the request", "input": { "row": { "id": "R-0034", "enabled": true, "ruleType": "application", "matchValue": "/var/www/* +override", "targetRoute": "secondary" } }, "expected": { "id": "R-0034", "enabled": true, "app-match": { "pattern": { "kind": "path", "value": "/var/www/*" }, "include-child-processes": false, "override-requested": true } } },
    { "name": "a denied program with +children and +override", "input": { "row": { "id": "R-0035", "enabled": false, "ruleType": "application", "matchValue": "svchost.exe +children +override", "targetRoute": "block" } } },
    { "name": "a broken path is still sent as a path for the service to refuse", "input": { "row": { "id": "R-0034", "enabled": true, "ruleType": "application", "matchValue": "C:\\Apps\\*.exe", "targetRoute": "primary" } } },
    { "name": "a spaced program name without the flag is sent as written","input": { "row": { "id": "R-0024", "enabled": true, "ruleType": "application", "matchValue": "Adobe  Reader.exe", "targetRoute": "primary" } } },
    { "name": "block action", "input": { "row": { "id": "R-0017", "enabled": true, "ruleType": "domain", "matchValue": "ads.example", "targetRoute": "block" } } },
    { "name": "verify action", "input": { "row": { "id": "R-0018", "enabled": true, "ruleType": "exact-fqdn", "matchValue": "shop.example", "targetRoute": "secondary", "verify": true } } },
    { "name": "verify action on primary address", "input": { "row": { "id": "R-0019", "enabled": true, "ruleType": "exact-ip", "matchValue": "192.0.2.8", "targetRoute": "primary", "verify": true } } },
    { "name": "verify dropped on a subnet", "input": { "row": { "id": "R-0020", "enabled": true, "ruleType": "subnet", "matchValue": "198.51.100.0/24", "targetRoute": "secondary", "verify": true } } },
    { "name": "verify dropped on a block", "input": { "row": { "id": "R-0021", "enabled": true, "ruleType": "domain", "matchValue": "ads.example", "targetRoute": "block", "verify": true } } },
    { "name": "auto origin kept", "input": { "row": { "id": "auto-1", "enabled": true, "ruleType": "domain", "matchValue": "img.site.example", "targetRoute": "secondary", "comment": "note", "originReason": "site-companion", "originAnchor": "site.example", "originAdded": "2026-01-01" } } },
    { "name": "routing only drops id, comment and origin", "input": { "row": { "id": "auto-2", "enabled": true, "ruleType": "domain", "matchValue": "img.site.example", "targetRoute": "secondary", "comment": "note", "originReason": "site-companion", "originAnchor": "site.example", "originAdded": "2026-01-01" }, "opts": { "keepId": false, "keepComment": false } } },
    { "name": "keepId false only", "input": { "row": { "id": "R-0019", "enabled": true, "ruleType": "zone", "matchValue": "example", "targetRoute": "primary", "comment": "kept" }, "opts": { "keepId": false } } },
    { "name": "empty reason is no origin", "input": { "row": { "id": "R-0020", "enabled": true, "ruleType": "domain", "matchValue": "x.example", "targetRoute": "secondary", "originReason": "", "originAnchor": "site.example" } } },
    { "name": "unknown type reads as a host", "input": { "row": { "id": "R-0021", "enabled": true, "ruleType": "linux-application", "matchValue": "*.odd.example", "targetRoute": "secondary" }, "encode": true } },
    { "name": "line break inside an application value is refused, not glued", "input": { "row": { "id": "R-0040", "enabled": true, "ruleType": "application", "matchValue": "my\napp.exe +children", "targetRoute": "secondary" } }, "expected": { "refused": "control-character" } },
    { "name": "control character in a bare program is refused", "input": { "row": { "id": "R-0041", "enabled": true, "ruleType": "application", "matchValue": "app\u0001.exe", "targetRoute": "primary" } }, "expected": { "refused": "control-character" } },
    { "name": "line break in a host value is refused", "input": { "row": { "id": "R-0042", "enabled": true, "ruleType": "domain", "matchValue": "exa\nmple.com", "targetRoute": "primary" }, "encode": true }, "expected": { "refused": "control-character" } },
    { "name": "DEL and C1 controls are refused too", "input": { "row": { "id": "R-0043", "enabled": true, "ruleType": "exact-ip", "matchValue": "192.0.2.7\u007f\u0085", "targetRoute": "secondary" } }, "expected": { "refused": "control-character" } },
    { "name": "routing-only form refuses as well", "input": { "row": { "id": "R-0044", "enabled": true, "ruleType": "subnet", "matchValue": "198.51.100.0/24\r", "targetRoute": "secondary" }, "opts": { "keepId": false, "keepComment": false } }, "expected": { "refused": "control-character" } },
    { "name": "a tab is whitespace, not a control character", "input": { "row": { "id": "R-0045", "enabled": true, "ruleType": "application", "matchValue": "my\tapp.exe", "targetRoute": "secondary" } }, "expected": { "id": "R-0045", "enabled": true, "app-match": { "pattern": { "kind": "exact", "value": "my\tapp.exe" }, "include-child-processes": false } } },
    { "name": "empty row", "input": { "row": {} } }
  ]
}
