{
  "description": "rules.js compareRuleRows: the sign of the order of two table rows under the chosen column and direction; text folds case first, then compares as written by UTF-16 code unit",
  "cases": [
    { "name": "value folds case", "input": { "a": { "id": "R-0002", "ruleType": "domain", "matchValue": "B.example", "targetRoute": "primary" }, "b": { "id": "R-0001", "ruleType": "domain", "matchValue": "a.example", "targetRoute": "primary" }, "sortBy": "by-match-value", "sortDir": "asc" }, "expected": 1 },
    { "name": "desc reverses", "input": { "a": { "id": "R-0002", "ruleType": "domain", "matchValue": "B.example", "targetRoute": "primary" }, "b": { "id": "R-0001", "ruleType": "domain", "matchValue": "a.example", "targetRoute": "primary" }, "sortBy": "by-match-value", "sortDir": "desc" }, "expected": -1 },
    { "name": "same letters fall back to the spelling", "input": { "a": { "id": "R-0001", "ruleType": "domain", "matchValue": "A.example", "targetRoute": "primary" }, "b": { "id": "R-0002", "ruleType": "domain", "matchValue": "a.example", "targetRoute": "primary" }, "sortBy": "by-match-value", "sortDir": "asc" }, "expected": -1 },
    { "name": "identical rows are equal both ways", "input": { "a": { "id": "R-0001", "ruleType": "domain", "matchValue": "a.example", "targetRoute": "primary" }, "b": { "id": "R-0001", "ruleType": "domain", "matchValue": "a.example", "targetRoute": "primary" }, "sortBy": "by-match-value", "sortDir": "desc" }, "expected": 0 },
    { "name": "cyrillic by code unit", "input": { "a": { "id": "R-0001", "ruleType": "domain", "matchValue": "ёлка.рф", "targetRoute": "primary" }, "b": { "id": "R-0002", "ruleType": "domain", "matchValue": "яблоко.рф", "targetRoute": "primary" }, "sortBy": "by-match-value", "sortDir": "asc" }, "expected": 1 },
    { "name": "type by the spelling the row arrived with", "input": { "a": { "id": "R-0001", "ruleType": "suffix-domain", "matchValue": "a.example", "targetRoute": "primary" }, "b": { "id": "R-0002", "ruleType": "domain", "matchValue": "z.example", "targetRoute": "primary" }, "sortBy": "by-type", "sortDir": "asc" }, "expected": 1 },
    { "name": "type tie falls back to the value", "input": { "a": { "id": "R-0001", "ruleType": "zone", "matchValue": "ru", "targetRoute": "primary" }, "b": { "id": "R-0002", "ruleType": "zone", "matchValue": "com", "targetRoute": "primary" }, "sortBy": "by-type", "sortDir": "asc" }, "expected": 1 },
    { "name": "route block before primary", "input": { "a": { "id": "R-0001", "ruleType": "domain", "matchValue": "z.example", "targetRoute": "block" }, "b": { "id": "R-0002", "ruleType": "domain", "matchValue": "a.example", "targetRoute": "primary" }, "sortBy": "by-route", "sortDir": "asc" }, "expected": -1 },
    { "name": "route tie falls back to the value", "input": { "a": { "id": "R-0001", "ruleType": "domain", "matchValue": "b.example", "targetRoute": "secondary" }, "b": { "id": "R-0002", "ruleType": "domain", "matchValue": "a.example", "targetRoute": "secondary" }, "sortBy": "by-route", "sortDir": "asc" }, "expected": 1 },
    { "name": "main route silent first", "input": { "a": { "id": "R-0001", "ruleType": "domain", "matchValue": "z.example", "targetRoute": "secondary", "mainRoute": "silent" }, "b": { "id": "R-0002", "ruleType": "domain", "matchValue": "a.example", "targetRoute": "secondary", "mainRoute": "answered" }, "sortBy": "by-main-route", "sortDir": "asc" }, "expected": -1 },
    { "name": "main route unchecked last", "input": { "a": { "id": "R-0001", "ruleType": "domain", "matchValue": "a.example", "targetRoute": "secondary" }, "b": { "id": "R-0002", "ruleType": "domain", "matchValue": "z.example", "targetRoute": "secondary", "mainRoute": "unclear" }, "sortBy": "by-main-route", "sortDir": "asc" }, "expected": 1 },
    { "name": "main route unchecked last, descending", "input": { "a": { "id": "R-0001", "ruleType": "domain", "matchValue": "a.example", "targetRoute": "secondary" }, "b": { "id": "R-0002", "ruleType": "domain", "matchValue": "z.example", "targetRoute": "secondary", "mainRoute": "no-address" }, "sortBy": "by-main-route", "sortDir": "desc" }, "expected": -1 },
    { "name": "main route tie falls back to the value", "input": { "a": { "id": "R-0001", "ruleType": "domain", "matchValue": "b.example", "targetRoute": "secondary" }, "b": { "id": "R-0002", "ruleType": "domain", "matchValue": "a.example", "targetRoute": "secondary" }, "sortBy": "by-main-route", "sortDir": "asc" }, "expected": 1 },
    { "name": "display order by id", "input": { "a": { "id": "R-0002", "ruleType": "domain", "matchValue": "a.example", "targetRoute": "primary" }, "b": { "id": "R-0010", "ruleType": "domain", "matchValue": "a.example", "targetRoute": "primary" }, "sortBy": "by-display-order", "sortDir": "asc" }, "expected": -1 },
    { "name": "an unknown column is display order", "input": { "a": { "id": "R-0003", "ruleType": "domain", "matchValue": "a.example", "targetRoute": "primary" }, "b": { "id": "R-0001", "ruleType": "domain", "matchValue": "z.example", "targetRoute": "primary" }, "sortBy": "by-something-new", "sortDir": "asc" }, "expected": 1 }
  ]
}
