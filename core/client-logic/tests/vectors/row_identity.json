{
  "description": "rules.js mergeKey / ruleSignature: import-merge identity and duplicate signature of a table row",
  "cases": [
    { "name": "domain", "input": { "row": { "ruleType": "domain", "matchValue": "Site.Example", "targetRoute": "secondary", "enabled": true } } },
    { "name": "suffix-domain folds into domain", "input": { "row": { "ruleType": "suffix-domain", "matchValue": "site.example", "targetRoute": "secondary", "enabled": true } } },
    { "name": "exact-ipv4 folds into exact-ip", "input": { "row": { "ruleType": "exact-ipv4", "matchValue": "192.0.2.7", "targetRoute": "primary", "enabled": true } } },
    { "name": "exact-ipv6 folds into exact-ip", "input": { "row": { "ruleType": "exact-ipv6", "matchValue": "2001:DB8::7", "targetRoute": "primary", "enabled": true } } },
    { "name": "upper-case type folds", "input": { "row": { "ruleType": "SUFFIX-DOMAIN", "matchValue": "a.example", "targetRoute": "primary", "enabled": true } } },
    { "name": "mixed-case unknown type", "input": { "row": { "ruleType": "Zone", "matchValue": "RU", "targetRoute": "secondary", "enabled": true } } },
    { "name": "route case kept in merge key only", "input": { "row": { "ruleType": "zone", "matchValue": "example", "targetRoute": "Secondary", "enabled": true } } },
    { "name": "block pseudo-route", "input": { "row": { "ruleType": "domain", "matchValue": "*.ads.example", "targetRoute": "block", "enabled": false } } },
    { "name": "verify is not identity", "input": { "row": { "ruleType": "exact-fqdn", "matchValue": "video.example", "targetRoute": "secondary", "verify": true, "enabled": true } } },
    { "name": "cyrillic value lower-cased", "input": { "row": { "ruleType": "domain", "matchValue": "Пример.РФ", "targetRoute": "secondary", "enabled": true } } },
    { "name": "application path", "input": { "row": { "ruleType": "application", "matchValue": "C:\\Program Files\\App\\App.EXE", "targetRoute": "secondary", "enabled": true } } },
    { "name": "empty row", "input": { "row": {} } }
  ]
}
