{
  "description": "pure.js planAppRouteAssignments / nrr_client_logic::app_routes: primary removes every covering application rule, secondary prefers the exact spelling, enables a disabled rule, adds only what nothing covers",
  "cases": [
    { "name": "primary removes covering patterns", "input": { "rules": [ { "value": "vbox*.exe", "route": "secondary", "enabled": true }, { "value": "other.exe", "route": "secondary", "enabled": true }, { "value": "VBoxHeadless.exe", "route": "block", "enabled": false } ], "assignments": [ { "value": "vboxheadless.exe", "route": "primary" } ] }, "expected": { "remove": [0, 2], "retarget": [], "add": [] } },
    { "name": "primary with nothing to remove", "input": { "rules": [ { "value": "a.exe", "route": "secondary", "enabled": true } ], "assignments": [ { "value": "b.exe", "route": "primary" } ] }, "expected": { "remove": [], "retarget": [], "add": [] } },
    { "name": "secondary prefers exact spelling", "input": { "rules": [ { "value": "vbox*.exe", "route": "primary", "enabled": true }, { "value": "VBoxHeadless.EXE", "route": "primary", "enabled": true } ], "assignments": [ { "value": "vboxheadless.exe", "route": "secondary" } ] }, "expected": { "remove": [], "retarget": [1], "add": [] } },
    { "name": "secondary falls back to a covering pattern", "input": { "rules": [ { "value": "vbox*.exe", "route": "primary", "enabled": true } ], "assignments": [ { "value": "vboxheadless.exe", "route": "secondary" } ] }, "expected": { "remove": [], "retarget": [0], "add": [] } },
    { "name": "secondary enables a disabled rule", "input": { "rules": [ { "value": "a.exe", "route": "secondary", "enabled": false } ], "assignments": [ { "value": "a.exe", "route": "secondary" } ] }, "expected": { "remove": [], "retarget": [0], "add": [] } },
    { "name": "secondary leaves a working rule alone", "input": { "rules": [ { "value": "a.exe", "route": "secondary", "enabled": true } ], "assignments": [ { "value": "A.EXE", "route": "secondary" } ] }, "expected": { "remove": [], "retarget": [], "add": [] } },
    { "name": "secondary adds a missing program once", "input": { "rules": [], "assignments": [ { "value": "a.exe", "route": "secondary" }, { "value": "A.exe", "route": "secondary" } ] }, "expected": { "remove": [], "retarget": [], "add": ["a.exe"] } },
    { "name": "cyrillic exact beats pattern", "input": { "rules": [ { "value": "прог*", "route": "primary", "enabled": true }, { "value": "ПРОГРАММА.exe", "route": "primary", "enabled": true } ], "assignments": [ { "value": "программа.exe", "route": "secondary" } ] }, "expected": { "remove": [], "retarget": [1], "add": [] } },
    { "name": "blocked rule is retargeted", "input": { "rules": [ { "value": "a.exe", "route": "block", "enabled": true } ], "assignments": [ { "value": "a.exe", "route": "secondary" } ] }, "expected": { "remove": [], "retarget": [0], "add": [] } },
    { "name": "empty values are ignored", "input": { "rules": [ { "value": "a.exe", "route": "secondary", "enabled": true } ], "assignments": [ { "value": "", "route": "primary" }, { "value": "", "route": "secondary" } ] }, "expected": { "remove": [], "retarget": [], "add": [] } },
    { "name": "flags on a rule do not hide it from secondary", "input": { "rules": [ { "value": "VBoxHeadless.exe +children", "route": "secondary", "enabled": true }, { "value": "vbox*.exe +override", "route": "primary", "enabled": false } ], "assignments": [ { "value": "vboxheadless.exe", "route": "secondary" }, { "value": "vboxsvc.exe", "route": "secondary" } ] }, "expected": { "remove": [], "retarget": [1], "add": [] } },
    { "name": "flags on a rule do not hide it from primary", "input": { "rules": [ { "value": "VBoxHeadless.exe +children +override", "route": "secondary", "enabled": true }, { "value": "other.exe +children", "route": "secondary", "enabled": true } ], "assignments": [ { "value": "vboxheadless.exe", "route": "primary" } ] }, "expected": { "remove": [0], "retarget": [], "add": [] } },
    { "name": "a flag word in first place is the value", "input": { "rules": [ { "value": "+children", "route": "secondary", "enabled": true } ], "assignments": [ { "value": "+children", "route": "secondary" } ] }, "expected": { "remove": [], "retarget": [], "add": [] } }
  ]
}
