{
  "description": "pure.js routePolicyRestorePlan",
  "cases": [
    {
      "name": "nothing to restore",
      "input": {
        "intent": {
          "leak-protection": "everything"
        },
        "service": {
          "leak-protection": "everything"
        },
        "present": []
      },
      "expected": {
        "keys": [],
        "missing": [],
        "values": null,
        "applyOnly": null
      }
    },
    {
      "name": "one switch",
      "input": {
        "intent": {
          "resolve-hosts-bypass": false
        },
        "service": {},
        "present": []
      },
      "expected": {
        "keys": [
          "resolve-hosts-bypass"
        ],
        "missing": [],
        "values": {
          "resolve-hosts-bypass": false
        },
        "applyOnly": [
          "resolve-hosts-bypass"
        ]
      }
    },
    {
      "name": "a number recorded as text goes as a number",
      "input": {
        "intent": {
          "primary-probe-timeout-ms": "2000"
        },
        "service": {},
        "present": []
      },
      "expected": {
        "keys": [
          "primary-probe-timeout-ms"
        ],
        "missing": [],
        "values": {
          "primary-probe-timeout-ms": 2000
        },
        "applyOnly": [
          "primary-probe-timeout-ms"
        ]
      }
    },
    {
      "name": "a binding whose adapter is here",
      "input": {
        "intent": {
          "secondary": {
            "stable-id": "B",
            "display-name": "Tunnel",
            "user-confirmed": true
          }
        },
        "service": {},
        "present": [
          "A",
          "B"
        ]
      },
      "expected": {
        "keys": [
          "secondary"
        ],
        "missing": [],
        "values": {
          "secondary": {
            "stable-id": "B",
            "display-name": "Tunnel",
            "user-confirmed": true
          }
        },
        "applyOnly": [
          "secondary"
        ]
      }
    },
    {
      "name": "a binding whose adapter is gone",
      "input": {
        "intent": {
          "secondary": {
            "stable-id": "B",
            "display-name": "Tunnel",
            "user-confirmed": true
          }
        },
        "service": {},
        "present": [
          "A"
        ]
      },
      "expected": {
        "keys": [],
        "missing": [
          {
            "role": "secondary",
            "name": "Tunnel"
          }
        ],
        "values": null,
        "applyOnly": null
      }
    },
    {
      "name": "a gone adapter with no name is named by its id",
      "input": {
        "intent": {
          "primary": {
            "stable-id": "A"
          }
        },
        "service": {},
        "present": []
      },
      "expected": {
        "keys": [],
        "missing": [
          {
            "role": "primary",
            "name": "A"
          }
        ],
        "values": null,
        "applyOnly": null
      }
    },
    {
      "name": "the rest goes without the missing adapter",
      "input": {
        "intent": {
          "mode": "prefer-secondary-when-available",
          "primary": {
            "stable-id": "A",
            "display-name": "Ethernet",
            "user-confirmed": true
          }
        },
        "service": { "leak-protection": "off" },
        "present": [
          "B"
        ]
      },
      "expected": {
        "keys": [
          "mode"
        ],
        "missing": [
          {
            "role": "primary",
            "name": "Ethernet"
          }
        ],
        "values": {
          "mode": "prefer-secondary-when-available"
        },
        "applyOnly": [
          "mode"
        ]
      }
    },
    {
      "name": "an unconfirmed binding stays unconfirmed",
      "input": {
        "intent": {
          "secondary": {
            "stable-id": "B",
            "display-name": "Tunnel"
          }
        },
        "service": {},
        "present": [
          "B"
        ]
      },
      "expected": {
        "keys": [
          "secondary"
        ],
        "missing": [],
        "values": {
          "secondary": {
            "stable-id": "B",
            "display-name": "Tunnel",
            "user-confirmed": false
          }
        },
        "applyOnly": [
          "secondary"
        ]
      }
    },
    {
      "name": "both bindings over others",
      "input": {
        "intent": {
          "primary": {
            "stable-id": "A",
            "display-name": "Ethernet",
            "user-confirmed": true
          },
          "secondary": {
            "stable-id": "B",
            "display-name": "Tunnel",
            "user-confirmed": true
          }
        },
        "service": {
          "primary": {
            "stable-id": "C",
            "display-name": "Wi-Fi",
            "user-confirmed": true
          }
        },
        "present": [
          "A",
          "B",
          "C"
        ]
      },
      "expected": {
        "keys": [
          "primary",
          "secondary"
        ],
        "missing": [],
        "values": {
          "primary": {
            "stable-id": "A",
            "display-name": "Ethernet",
            "user-confirmed": true
          },
          "secondary": {
            "stable-id": "B",
            "display-name": "Tunnel",
            "user-confirmed": true
          }
        },
        "applyOnly": [
          "primary",
          "secondary"
        ]
      }
    },
    {
      "name": "a re-matched binding needs nothing",
      "input": {
        "intent": {
          "secondary": {
            "stable-id": "B",
            "display-name": "Tunnel",
            "user-confirmed": true
          }
        },
        "service": {
          "secondary": {
            "stable-id": "B2",
            "display-name": "Tunnel",
            "user-confirmed": true,
            "known-stable-ids": [
              "B"
            ]
          }
        },
        "present": [
          "B2"
        ]
      },
      "expected": {
        "keys": [],
        "missing": [],
        "values": null,
        "applyOnly": null
      }
    },
    {
      "name": "protection the record holds on is not offered: it went back on its own",
      "input": {
        "intent": {
          "leak-protection": "everything",
          "mode": "prefer-secondary-when-available"
        },
        "service": { "leak-protection": "off", "secondary": { "stable-id": "B", "display-name": "Tunnel" } },
        "present": []
      },
      "expected": {
        "keys": [
          "mode"
        ],
        "missing": [],
        "values": {
          "mode": "prefer-secondary-when-available"
        },
        "applyOnly": [
          "mode"
        ]
      }
    },
    {
      "name": "everything with no additional adapter bound is offered together with the binding",
      "input": {
        "intent": {
          "leak-protection": "everything",
          "secondary": {
            "stable-id": "B",
            "display-name": "Tunnel",
            "user-confirmed": true
          }
        },
        "service": {},
        "present": [
          "B"
        ]
      },
      "expected": {
        "keys": [
          "leak-protection",
          "secondary"
        ],
        "missing": [],
        "values": {
          "leak-protection": "everything",
          "secondary": {
            "stable-id": "B",
            "display-name": "Tunnel",
            "user-confirmed": true
          }
        },
        "applyOnly": [
          "leak-protection",
          "secondary"
        ]
      }
    },
    {
      "name": "protection the record holds weaker is offered, never sent on its own",
      "input": {
        "intent": {
          "leak-protection": "off"
        },
        "service": {
          "leak-protection": "sites"
        },
        "present": []
      },
      "expected": {
        "keys": [
          "leak-protection"
        ],
        "missing": [],
        "values": {
          "leak-protection": "off"
        },
        "applyOnly": [
          "leak-protection"
        ]
      }
    },
    {
      "name": "a restored additional default route takes routed sites to everything",
      "input": {
        "intent": {
          "mode": "prefer-secondary-when-available"
        },
        "service": {
          "mode": "prefer-primary",
          "leak-protection": "sites"
        },
        "present": []
      },
      "expected": {
        "keys": [
          "leak-protection",
          "mode"
        ],
        "missing": [],
        "values": {
          "leak-protection": "everything",
          "mode": "prefer-secondary-when-available"
        },
        "applyOnly": [
          "leak-protection",
          "mode"
        ]
      }
    },
    {
      "name": "routed sites recorded under the additional route the service holds is what it holds",
      "input": {
        "intent": {
          "leak-protection": "sites"
        },
        "service": {
          "mode": "prefer-secondary-when-available",
          "leak-protection": "everything"
        },
        "present": []
      },
      "expected": {
        "keys": [],
        "missing": [],
        "values": null,
        "applyOnly": null
      }
    },
    {
      "name": "a restored main default route keeps the level the service holds",
      "input": {
        "intent": {
          "mode": "prefer-primary",
          "leak-protection": "sites"
        },
        "service": {
          "mode": "prefer-secondary-when-available",
          "leak-protection": "everything"
        },
        "present": []
      },
      "expected": {
        "keys": [
          "mode"
        ],
        "missing": [],
        "values": {
          "mode": "prefer-primary"
        },
        "applyOnly": [
          "mode"
        ]
      }
    },
    {
      "name": "the strict mode of an earlier build offers the additional route, its protection having gone back by itself",
      "input": {
        "intent": {
          "mode": "strict-secondary-fail-closed",
          "kill-switch-enabled": true
        },
        "service": { "leak-protection": "off", "secondary": { "stable-id": "B", "display-name": "Tunnel" } },
        "present": []
      },
      "expected": {
        "keys": [
          "mode"
        ],
        "missing": [],
        "values": {
          "mode": "prefer-secondary-when-available"
        },
        "applyOnly": [
          "mode"
        ]
      }
    }
  ]
}
