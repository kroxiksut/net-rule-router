{
  "description": "rules.js planBulkRules / nrr_client_logic::bulk_rules::plan_bulk_rules: what pasting rules-file lines into the Add form does with each line. `expected` is a digest of the plan; the whole plan is also compared JS against Rust.",
  "cases": [
    {
      "name": "plain values name their own type",
      "input": {
        "text": "example.com\n*.example.net\nexample.*\n192.0.2.7\n198.51.100.0/24\n192.0.2.10-192.0.2.40\n*.ru\nchrome.exe\n",
        "route": "primary",
        "os": "windows",
        "verdicts": {
          "domain|example.com": {
            "status": "valid"
          },
          "domain|*.example.net": {
            "status": "valid"
          },
          "domain|example.*": {
            "status": "valid"
          },
          "exact-ip|192.0.2.7": {
            "status": "valid"
          },
          "subnet|198.51.100.0/24": {
            "status": "valid"
          },
          "ip-range|192.0.2.10-192.0.2.40": {
            "status": "valid"
          },
          "zone|*.ru": {
            "status": "valid"
          },
          "application|chrome.exe": {
            "status": "valid"
          }
        }
      },
      "expected": {
        "rows": [
          "1 domain ok add primary on - - - - - example.com",
          "2 domain ok add primary on - - - - - *.example.net",
          "3 domain ok add primary on - - - - - example.*",
          "4 exact-ip ok add primary on - - - - - 192.0.2.7",
          "5 subnet ok add primary on - - - - - 198.51.100.0/24",
          "6 ip-range ok add primary on - - - - - 192.0.2.10-192.0.2.40",
          "7 zone ok add primary on - - - - - *.ru",
          "8 application ok add primary on - - - - - chrome.exe"
        ],
        "lines": 8,
        "excess": 0,
        "bound": "",
        "counts": "8/0/0/0",
        "remaining": ""
      }
    },
    {
      "name": "deny, check, turned off and notes",
      "input": {
        "text": "!ads.example.net  # ads\n?mail.example.com\n# old.example.com\n# !gone.example.org\n# just a note here\n## heading\n#: hint line\n",
        "route": "secondary",
        "os": "windows",
        "verdicts": {
          "domain|ads.example.net": {
            "status": "valid"
          },
          "domain|mail.example.com": {
            "status": "valid"
          },
          "domain|old.example.com": {
            "status": "valid"
          },
          "domain|gone.example.org": {
            "status": "valid"
          }
        }
      },
      "expected": {
        "rows": [
          "1 domain ok add block on - - - - #ads ads.example.net",
          "2 domain ok add secondary on ? - - - - mail.example.com",
          "3 domain ok add secondary off - - - - - old.example.com",
          "4 domain ok add block off - - - - - gone.example.org"
        ],
        "lines": 7,
        "excess": 0,
        "bound": "",
        "counts": "4/0/0/0",
        "remaining": ""
      }
    },
    {
      "name": "one word asks for its type",
