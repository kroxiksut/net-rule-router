          "5 exact-ip error keep primary on - rules.validation.match-value-invalid.is-domain - - - example.com"
        ],
        "lines": 5,
        "excess": 0,
        "bound": "",
        "counts": "1/0/2/0",
        "remaining": "--- Domains\n192.0.2.7\n--- IP\nexample.com"
      }
    },
