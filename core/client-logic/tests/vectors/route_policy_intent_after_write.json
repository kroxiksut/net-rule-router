{
  "description": "pure.js routePolicyIntentAfterWrite",
  "cases": [
    {
      "name": "the first key recorded",
      "input": {
        "intent": {},
        "request": {
          "mode": "prefer-secondary-when-available"
        },
        "keys": [
          "mode"
        ]
      },
      "expected": {
        "mode": "prefer-secondary-when-available"
      }
    },
    {
      "name": "other recorded keys stay",
      "input": {
        "intent": {
          "leak-protection": "sites"
        },
        "request": {
          "mode": "prefer-primary"
        },
        "keys": [
          "mode"
        ]
      },
      "expected": {
        "leak-protection": "sites",
        "mode": "prefer-primary"
      }
    },
    {
      "name": "a value is overwritten",
      "input": {
        "intent": {
          "mode": "prefer-primary"
        },
        "request": {
          "mode": "prefer-secondary-when-available"
        },
        "keys": [
          "mode"
        ]
      },
      "expected": {
        "mode": "prefer-secondary-when-available"
      }
    },
    {
      "name": "an unbinding drops the recorded binding",
      "input": {
        "intent": {
          "primary": {
            "stable-id": "A",
            "display-name": "Ethernet",
            "user-confirmed": true
          },
          "mode": "prefer-primary"
        },
        "request": {
          "mode": "prefer-primary"
        },
        "keys": [
          "primary"
        ]
      },
      "expected": {
        "mode": "prefer-primary"
      }
    },
    {
      "name": "a null value drops its key",
      "input": {
        "intent": {
          "short-name-suffix": "corp"
        },
        "request": {
          "short-name-suffix": null
        },
        "keys": [
          "short-name-suffix"
        ]
      },
      "expected": {}
    },
    {
      "name": "a binding is recorded whole",
      "input": {
        "intent": {},
        "request": {
          "secondary": {
            "stable-id": "B",
            "display-name": "Tunnel",
            "user-confirmed": true
          },
          "mode": "prefer-primary"
        },
        "keys": [
          "secondary"
        ]
      },
      "expected": {
        "secondary": {
          "stable-id": "B",
          "display-name": "Tunnel",
          "user-confirmed": true
        }
      }
    },
    {
      "name": "no named keys change nothing",
      "input": {
        "intent": {
          "leak-protection": "off"
        },
        "request": {
          "leak-protection": "sites"
        },
        "keys": []
      },
      "expected": {
        "leak-protection": "off"
      }
    },
    {
      "name": "a key neither side has stays absent",
      "input": {
        "intent": {},
        "request": {},
        "keys": [
          "doh-lockdown-enabled"
        ]
      },
      "expected": {}
    },
    {
      "name": "only the named keys of a full request",
      "input": {
        "intent": {},
        "request": {
          "mode": "prefer-primary",
          "leak-protection": "sites",
          "include-subdomains": true
        },
        "keys": [
          "leak-protection"
        ]
      },
      "expected": {
        "leak-protection": "sites"
      }
    }
  ]
}
