# Local environment overrides for developer machines.
# Keep secrets out of the repository.

NRR_ENV=development
NRR_LOG_LEVEL=debug
NRR_RUST_TARGET=x86_64-pc-windows-msvc

# Optional: point the build at a specific Qt installation
# NRR_QT_ROOT=C:\Qt\6.6.3\msvc2019_64
# CMAKE_PREFIX_PATH=C:\Qt\6.6.3\msvc2019_64
