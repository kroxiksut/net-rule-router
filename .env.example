# Template for a local .env. Nothing loads this file automatically: the
# variables below are read from the process environment. Keep secrets out of
# the repository. The full list is in TECHNICAL.md.

# Rust target used by the bootstrap and build scripts
NRR_RUST_TARGET=x86_64-pc-windows-msvc

# Optional: point the build at a specific Qt installation
# CMAKE_PREFIX_PATH=C:\Qt\6.6.3\msvc2019_64

# Optional development overrides
# NRR_LOG=nrr=debug,info
# NRR_BACKEND=mock
